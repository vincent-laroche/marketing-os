{
  "name": "marketing-os-social-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "tsc --noEmit",
    "verify": "npm run lint && npm run build",
    "build:public-gallery": "node public-gallery/build.mjs",
    "verify:public-gallery": "npm run build:public-gallery && node public-gallery/verify.mjs",
    "deploy:public-gallery": "npm run verify:public-gallery && wrangler deploy --config public-gallery/wrangler.jsonc",
    "deploy:worker:legacy": "cd dist/server && wrangler deploy --config wrangler.json --name social-marketing-studio --domain social-marketing-studio.hairsolutions.co --keep-vars"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
