{
  "name": "social-marketing-studio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "social-marketing-studio.hairsolutions.co",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
