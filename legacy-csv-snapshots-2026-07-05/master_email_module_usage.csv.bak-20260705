usage_214988061003_module_7_0_0_8,214988061003,CP W26 — Half Year Recap,AUTOMATED_DRAFT,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/ecommerce/ecommerce_abandoned_cart_4.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,,module-7-0-0,,,,section-7,7,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""display"":""default"",""font"":{""color"":""{{is_ungated_for_email_branded_templates && style_settings.initial_source == 'BRANDED_TEMPLATE' ? style_settings.secondary_font_color : '#757575'}}"",""font"":""Lato,Tahoma,sans-serif"",""font_set"":""DEFAULT"",""size"":{""units"":""px"",""value"":15}},""footer_html"":""<p style=\""text-align: center; font-size: 16px; line-height: 125%;\""><span style=\""font-family: Lato, Tahoma, sans-serif; color: #FFFFFF;\"">{{site_settings.company_name}}, {{site_settings.company_street_address_1}}, {{site_settings.company_street_address_2}},{{site_settings.company_city}}, {{site_settings.company_state}}</span></p>\n<p><span style=\""font-family: Lato, Tahoma, sans-serif; color: #FFFFFF;\""> </span></p>\n<p style=\""text-align: center; font-size: 18px; line-height: 125%;\""><span style=\""font-family: Lato, Tahoma, sans-serif; color: #FFFFFF;\"">&nbsp;</span></p>\n<p><span style=\""font-family: Lato, Tahoma, sans-serif; color: #FFFFFF;\""> </span></p>\n<p style=\""font-size: 15px; line-height: 125%; text-align: center;\""><span style=\""font-family: Lato, Tahoma, sans-serif; color: #FFFFFF;\""><a href=\""{{ unsubscribe_link_all }}\"" style=\""color: #FFFFFF;\"" data-unsubscribe=\""true\"">Unsubscribe</a> &nbsp;&nbsp; <a href=\""{{ unsubscribe_link }}\"" style=\""color: #FFFFFF;\"" data-unsubscribe=\""true\"">Manage preferences</a></span></p>\n<p style=\""font-size: 12px; line-height: 125%; text-align: center;\""><span style=\""color: #FFFFFF;\"">&nbsp;</span></p>"",""hs_enable_module_padding"":true,""hs_wrapper_css"":{""padding-bottom"":""28px"",""padding-left"":""10px"",""padding-right"":""10px"",""padding-top"":""0px""},""lineNumber"":326,""link_font"":{""color"":""{{is_ungated_for_email_branded_templates && style_settings.initial_source == 'BRANDED_TEMPLATE' ? style_settings.secondary_font_color : '#757575'}}"",""font"":""Lato,Tahoma,sans-serif"",""font_set"":""DEFAULT"",""size"":{""units"":""px"",""value"":15},""styles"":{""bold"":false,""italic"":false,""underline"":true}},""parent_widget_container"":null,""schema_version"":2,""startPosition"":-480,""unsubscribe_link_type"":""both""}",4664f2874e88e860249604d3bbafdc8f1b59f326500ccb4924d9fc9f63916122,False,True,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214988061042_module_0_0_0_0,214988061042,J7-E2 — What's New,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<table width=\""100%\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""background-color:#f9f7f4;\"">\n  <tr><td align=\""center\"" style=\""padding:32px 16px;\"">\n    <table width=\""580\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""max-width:580px;width:100%;background-color:#ffffff;border-radius:4px;overflow:hidden;\"">\n\n      <!-- HEADER -->\n      <tr><td style=\""background-color:#1a1a1a;padding:28px 40px;text-align:center;\"">\n        <span style=\""color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;\"">Hair Solutions Co.</span>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\""padding:40px;color:#1a1a1a;font-family:Georgia,'Times New Roman',serif;\"">\n        <h2 style=\""font-family:Arial,sans-serif;font-size:22px;font-weight:bold;margin:0 0 20px;color:#1a1a1a;\"">Hi {{ contact.firstname | default(\""there\"") }},</h2>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Thanks for taking a moment to read my last note — I really appreciate it.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">I wanted to share a few things that have changed since you’ve been away. We’ve refined our base materials, expanded our color-matching system, and added new lighter, more breathable options that a lot of long-time clients are loving.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">We’ve also made the consultation process faster — most questions can now be answered in a single video call, no pressure, no obligation.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">If you’re curious what’s new or just want to see updated photos, our team is happy to walk you through it.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Either way, it’s good to have you on our list.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">&mdash; Vincent<br>Hair Solutions Co.</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\""background-color:#f9f7f4;padding:24px 40px;text-align:center;\"">\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0 0 6px;line-height:1.5;\"">Hair Solutions Co. &bull; <a href=\""https://hairsolutions.co\"" style=\""color:#999999;text-decoration:none;\"">hairsolutions.co</a></p>\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0;line-height:1.5;\"">\n          <a href=\""{{ unsubscribe_link }}\"" style=\""color:#999999;\"">Unsubscribe</a> &bull;\n          <a href=\""{{ subscription_preferences_link }}\"" style=\""color:#999999;\"">Manage preferences</a>\n        </p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>"",""schema_version"":2}",de742f30064c30d402edc67e7f97747be797b37bc3d0e580e7768e518b26db68,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214988061042_module_1_0_0_1,214988061042,J7-E2 — What's New,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214988061045_module_0_0_0_0,214988061045,J4-E2 — Replacement Nudge,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<table width=\""100%\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""background-color:#f9f7f4;\"">\n  <tr><td align=\""center\"" style=\""padding:32px 16px;\"">\n    <table width=\""580\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""max-width:580px;width:100%;background-color:#ffffff;border-radius:4px;overflow:hidden;\"">\n\n      <!-- HEADER -->\n      <tr><td style=\""background-color:#1a1a1a;padding:28px 40px;text-align:center;\"">\n        <span style=\""color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;\"">Hair Solutions Co.</span>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\""padding:40px;color:#1a1a1a;font-family:Georgia,'Times New Roman',serif;\"">\n        <h2 style=\""font-family:Arial,sans-serif;font-size:22px;font-weight:bold;margin:0 0 20px;color:#1a1a1a;\"">Hi {{ contact.firstname | default(\""there\"") }},</h2>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Hope your system has been treating you well.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Most of our clients find that after a few months of regular wear, a system starts to show its age — the hairline softens, density thins slightly, and the base isn’t quite as crisp as day one.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">If that sounds familiar, it might be a good time to start thinking about your next system. Replacing on schedule keeps your look consistently sharp, and it’s much easier to plan ahead than to scramble later.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">We can use your existing measurements and preferences on file, so reordering is quick — no need to redo your full consultation unless you’d like to.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">&mdash; The Hair Solutions Co. Team</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\""background-color:#f9f7f4;padding:24px 40px;text-align:center;\"">\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0 0 6px;line-height:1.5;\"">Hair Solutions Co. &bull; <a href=\""https://hairsolutions.co\"" style=\""color:#999999;text-decoration:none;\"">hairsolutions.co</a></p>\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0;line-height:1.5;\"">\n          <a href=\""{{ unsubscribe_link }}\"" style=\""color:#999999;\"">Unsubscribe</a> &bull;\n          <a href=\""{{ subscription_preferences_link }}\"" style=\""color:#999999;\"">Manage preferences</a>\n        </p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>"",""schema_version"":2}",ac8466691e05de66f109a8f6bcc5dd91def23ee5e874bfbc423d148858f0fe1c,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
