usage_214988110717_module_0_0_0_0,214988110717,LAUNCH · C · Bold launch · conversion-focused,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<table width=\""100%\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""background-color:#f9f7f4;\"">\n  <tr><td align=\""center\"" style=\""padding:32px 16px;\"">\n    <table width=\""580\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""max-width:580px;width:100%;background-color:#ffffff;border-radius:4px;overflow:hidden;\"">\n\n      <!-- HEADER -->\n      <tr><td style=\""background-color:#1a1a1a;padding:28px 40px;text-align:center;\"">\n        <span style=\""color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;\"">Hair Solutions Co.</span>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\""padding:40px;color:#1a1a1a;font-family:Georgia,'Times New Roman',serif;\"">\n        <h2 style=\""font-family:Arial,sans-serif;font-size:22px;font-weight:bold;margin:0 0 20px;color:#1a1a1a;\"">Hi {{ contact.firstname | default(\""there\"") }},</h2>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Big news: Hair Solutions Co. has a brand-new look.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">We’ve completely rebuilt our website — faster, clearer, and easier to use — with redesigned product pages, better photos, and a streamlined ordering process from start to finish.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">To celebrate, we’re offering a limited-time discount on your next order. This won’t be up for long.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Take a look at the new site and see what’s changed — we think you’ll notice the difference right away.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">&mdash; The Hair Solutions Co. Team</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\""background-color:#f9f7f4;padding:24px 40px;text-align:center;\"">\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0 0 6px;line-height:1.5;\"">Hair Solutions Co. &bull; <a href=\""https://hairsolutions.co\"" style=\""color:#999999;text-decoration:none;\"">hairsolutions.co</a></p>\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0;line-height:1.5;\"">\n          <a href=\""{{ unsubscribe_link }}\"" style=\""color:#999999;\"">Unsubscribe</a> &bull;\n          <a href=\""{{ subscription_preferences_link }}\"" style=\""color:#999999;\"">Manage preferences</a>\n        </p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>"",""schema_version"":2}",7f70bcedd524fd778737ff80ca22b472c26fbffd243ba56fcc2f4f6ad1d68e40,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
