usage_214988060982_module_1_0_0_1,214988060982,CP W14 — New Arrivals Spotlight,AUTOMATED_DRAFT,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/ecommerce/ecommerce_abandoned_cart_4.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,,module-1-0-0,,,,section-1,1,0,0,,"{""css_class"":""dnd-module"",""hs_enable_module_padding"":true,""hs_wrapper_css"":{""padding-bottom"":""28px"",""padding-left"":""40px"",""padding-right"":""40px"",""padding-top"":""16px""},""html"":""<div style=\""font-family:Helvetica Neue,Helvetica,Arial,sans-serif;line-height:150%;color:#FFFFFF;\""><h1 style=\""margin:0;font-family:Arial Black,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:52px;line-height:108%;font-weight:700;letter-spacing:-0.3px;text-align:center;color:#FFFFFF;\"">NEW ARRIVALS ARE HERE.</h1><p style=\""margin:16px 0 0 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;text-align:center;color:#FFFFFF;\"">Engineered for the look you've been waiting for.</p></div>"",""lineNumber"":94,""parent_widget_container"":null,""schema_version"":2,""startPosition"":-442}",355accac1c61542b522f0a724a00f383be482688ae5308bafcffcac77df817e4,False,True,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214988060982_module_2_0_0_2,214988060982,CP W14 — New Arrivals Spotlight,AUTOMATED_DRAFT,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/ecommerce/ecommerce_abandoned_cart_4.html,builtin_hubspot_image_email,builtin_hubspot,HubSpot built-in modules,@hubspot/image_email,,module-2-0-0,,,,section-2,2,0,0,,"{""css_class"":""dnd-module"",""hs_enable_module_padding"":true,""hs_wrapper_css"":{""padding-bottom"":""20px"",""padding-left"":""20px"",""padding-right"":""20px"",""padding-top"":""20px""},""img"":{""alt"":""HS1V frontal hair system product showcase highlighting the natural front hairline"",""height"":320,""loading"":""disabled"",""src"":""https://res.cloudinary.com/dtmizxj1n/image/upload/w_600,q_auto,f_auto/v1/HS1VFRONTAL-7"",""width"":560},""lineNumber"":61,""link"":""https://hairsolutions.co/collections/new-arrivals"",""parent_widget_container"":null,""schema_version"":2,""startPosition"":-1015}",6414d5bc2fc73ee9a16d1652907921cb7c04a21457560e1246c50f47e20e4844,False,True,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214988060982_module_3_0_0_3,214988060982,CP W14 — New Arrivals Spotlight,AUTOMATED_DRAFT,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/ecommerce/ecommerce_abandoned_cart_4.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,,module-3-0-0,,,,section-3,3,0,0,,"{""css_class"":""dnd-module"",""hs_enable_module_padding"":true,""hs_wrapper_css"":{""padding-bottom"":""20px"",""padding-left"":""40px"",""padding-right"":""40px"",""padding-top"":""16px""},""html"":""<div style=\""font-family:Helvetica Neue,Helvetica,Arial,sans-serif;line-height:150%;color:#1A1A1A;\""><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\"">We just added three new hair replacement systems to the lineup — and each one was built to solve a specific problem better than anything we have offered before.</p><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\""><strong>The Meridian Lace</strong> is our thinnest, most breathable full-lace system yet. If you have been waiting for a lace base that disappears into your scalp and handles summer heat without lifting, this is it. Ideal for active guys who want zero detection and maximum airflow.</p><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\""><strong>The Apex Hybrid</strong> combines a poly perimeter with a mono center for the best of both worlds — the secure bond of poly around the edges with the natural movement and comfort of mono where it matters most. This is our recommendation if you are newer to systems and want something forgiving but professional-looking.</p><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\""><strong>The Stealth Poly Ultra-Thin</strong> pushes the boundary on how thin a poly base can get. At 0.03mm, it contours to your scalp like a second skin. The hairline on this system is virtually undetectable, even under direct light.</p><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\"">Each system is available in our full range of colors and densities. And because these are fresh additions, stock is limited on the first run — once these sell through, the next batch is 4-6 weeks out.</p></div>"",""lineNumber"":94,""parent_widget_container"":null,""schema_version"":2,""startPosition"":-442}",f0915e090b26ddbea999b0371a5f2998b8ac39166424b6cfee106486f817c2ac,False,True,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
