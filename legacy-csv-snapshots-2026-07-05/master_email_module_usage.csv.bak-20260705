usage_214988110714_module_0_0_0_0,214988110714,J5-E4 — VIP Maintenance Check-In,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<table width=\""100%\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""background-color:#f9f7f4;\"">\n  <tr><td align=\""center\"" style=\""padding:32px 16px;\"">\n    <table width=\""580\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""max-width:580px;width:100%;background-color:#ffffff;border-radius:4px;overflow:hidden;\"">\n\n      <!-- HEADER -->\n      <tr><td style=\""background-color:#1a1a1a;padding:28px 40px;text-align:center;\"">\n        <span style=\""color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;\"">Hair Solutions Co.</span>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\""padding:40px;color:#1a1a1a;font-family:Georgia,'Times New Roman',serif;\"">\n        <h2 style=\""font-family:Arial,sans-serif;font-size:22px;font-weight:bold;margin:0 0 20px;color:#1a1a1a;\"">Hi {{ contact.firstname | default(\""there\"") }},</h2>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">As one of our valued long-term clients, we wanted to check in directly.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">How has your system been holding up? If anything feels off — fit, color, density, or comfort — our team can prioritize a fix or adjustment for you, often without needing a full replacement.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">You also have access to our priority support line for anything maintenance-related, so you don’t have to wait in the general queue.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Just reply to this email with any questions or concerns, and we’ll make sure it’s handled quickly.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">&mdash; Vincent<br>Hair Solutions Co.</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\""background-color:#f9f7f4;padding:24px 40px;text-align:center;\"">\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0 0 6px;line-height:1.5;\"">Hair Solutions Co. &bull; <a href=\""https://hairsolutions.co\"" style=\""color:#999999;text-decoration:none;\"">hairsolutions.co</a></p>\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0;line-height:1.5;\"">\n          <a href=\""{{ unsubscribe_link }}\"" style=\""color:#999999;\"">Unsubscribe</a> &bull;\n          <a href=\""{{ subscription_preferences_link }}\"" style=\""color:#999999;\"">Manage preferences</a>\n        </p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>"",""schema_version"":2}",c5b0ca69ead6644bc3bc5f903f392fa9ebadeaca4e6447ca6c6605c252348b1a,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
