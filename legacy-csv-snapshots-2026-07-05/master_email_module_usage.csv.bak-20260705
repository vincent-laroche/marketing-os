usage_214987971625_module_7_0_0_8,214987971625,CP W21 — Vip Early Access,AUTOMATED_DRAFT,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/ecommerce/ecommerce_abandoned_cart_4.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,,module-7-0-0,,,,section-7,7,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""display"":""default"",""font"":{""color"":""{{is_ungated_for_email_branded_templates && style_settings.initial_source == 'BRANDED_TEMPLATE' ? style_settings.secondary_font_color : '#757575'}}"",""font"":""Lato,Tahoma,sans-serif"",""font_set"":""DEFAULT"",""size"":{""units"":""px"",""value"":15}},""footer_html"":""<p style=\""text-align: center; font-size: 16px; line-height: 125%;\""><span style=\""font-family: Lato, Tahoma, sans-serif; color: #FFFFFF;\"">{{site_settings.company_name}}, {{site_settings.company_street_address_1}}, {{site_settings.company_street_address_2}},{{site_settings.company_city}}, {{site_settings.company_state}}</span></p>\n<p><span style=\""font-family: Lato, Tahoma, sans-serif; color: #FFFFFF;\""> </span></p>\n<p style=\""text-align: center; font-size: 18px; line-height: 125%;\""><span style=\""font-family: Lato, Tahoma, sans-serif; color: #FFFFFF;\"">&nbsp;</span></p>\n<p><span style=\""font-family: Lato, Tahoma, sans-serif; color: #FFFFFF;\""> </span></p>\n<p style=\""font-size: 15px; line-height: 125%; text-align: center;\""><span style=\""font-family: Lato, Tahoma, sans-serif; color: #FFFFFF;\""><a href=\""{{ unsubscribe_link_all }}\"" style=\""color: #FFFFFF;\"" data-unsubscribe=\""true\"">Unsubscribe</a> &nbsp;&nbsp; <a href=\""{{ unsubscribe_link }}\"" style=\""color: #FFFFFF;\"" data-unsubscribe=\""true\"">Manage preferences</a></span></p>\n<p style=\""font-size: 12px; line-height: 125%; text-align: center;\""><span style=\""color: #FFFFFF;\"">&nbsp;</span></p>"",""hs_enable_module_padding"":true,""hs_wrapper_css"":{""padding-bottom"":""28px"",""padding-left"":""10px"",""padding-right"":""10px"",""padding-top"":""0px""},""lineNumber"":326,""link_font"":{""color"":""{{is_ungated_for_email_branded_templates && style_settings.initial_source == 'BRANDED_TEMPLATE' ? style_settings.secondary_font_color : '#757575'}}"",""font"":""Lato,Tahoma,sans-serif"",""font_set"":""DEFAULT"",""size"":{""units"":""px"",""value"":15},""styles"":{""bold"":false,""italic"":false,""underline"":true}},""parent_widget_container"":null,""schema_version"":2,""startPosition"":-480,""unsubscribe_link_type"":""both""}",4664f2874e88e860249604d3bbafdc8f1b59f326500ccb4924d9fc9f63916122,False,True,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214988060961_module_0_0_0_0,214988060961,CP-Launch-01-Website-Announcement,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p><strong>We have big news: Hair Solutions Co. has relaunched.</strong></p>\n\n<p>New name. New website. Same commitment to premium hair systems — but with everything rebuilt from the ground up.</p>\n\n<p><strong>What's new:</strong></p>\n\n<p>🌐 <strong>Brand new website</strong> — <a href=\""https://hairsolutions.co\"">hairsolutions.co</a> — easier browsing, detailed product pages, and a smooth checkout experience.</p>\n\n<p>📦 <strong>Reliable fulfillment</strong> — Every order ships with tracking. No exceptions.</p>\n\n<p>🤝 <strong>Personal service</strong> — I'm Vincent, the founder, and I personally oversee every order and respond to every inquiry.</p>\n\n<p>💈 <strong>Expanded product line</strong> — More base types, colors, densities, and maintenance products than ever before.</p>\n\n<p><a href=\""https://hairsolutions.co?utm_source=hubspot&utm_medium=email&utm_campaign=2026-02-website-launch&utm_content=cp-launch-01&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">Visit the New Site →</a></p>\n\n<p>Thank you for being part of our community. I'm excited about what's ahead.</p>\n\n<p>Vincent Laroche<br>\nFounder, Hair Solutions Co.</p>"",""schema_version"":2}",0a86235574d8457ca25489197795e980ed2fb770f17e5b921dacd5f8a6456d01,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214988060961_module_1_0_0_1,214988060961,CP-Launch-01-Website-Announcement,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214988060964_module_0_0_0_0,214988060964,CP-Launch-02-Site-Tour-Followup,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p>Thanks for opening our announcement email! I wanted to give you a quick tour of what you'll find on our new site.</p>\n\n<p><strong>🔍 Easy product browsing</strong><br>\nFilter by base type (lace, poly, hybrid, mono), hair color, density, and length. Find your perfect match in minutes.<br>\n<a href=\""https://hairsolutions.co/collections/all?utm_source=hubspot&utm_medium=email&utm_campaign=2026-02-website-launch&utm_content=cp-launch-02&utm_term=collections\"">Browse Collections →</a></p>\n\n<p><strong>📖 Education hub</strong><br>\nNew guides, tutorials, and comparison articles to help you make informed decisions.<br>\n<a href=\""https://hairsolutions.co/blogs/guides?utm_source=hubspot&utm_medium=email&utm_campaign=2026-02-website-launch&utm_content=cp-launch-02&utm_term=guides\"">Read Guides →</a></p>\n\n<p><strong>🧴 Maintenance store</strong><br>\nEverything you need to maintain your system — adhesives, tapes, removers, shampoo, and more.<br>\n<a href=\""https://hairsolutions.co/collections/maintenance?utm_source=hubspot&utm_medium=email&utm_campaign=2026-02-website-launch&utm_content=cp-launch-02&utm_term=maintenance\"">Shop Maintenance →</a></p>\n\n<p><a href=\""https://hairsolutions.co?utm_source=hubspot&utm_medium=email&utm_campaign=2026-02-website-launch&utm_content=cp-launch-02&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">Take the Full Tour →</a></p>\n\n<p>Vincent</p>"",""schema_version"":2}",ad618d5cf66b6472783fd0749675423e9ad892c4efb4ac4f2d2e417882b42874,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214988060964_module_1_0_0_1,214988060964,CP-Launch-02-Site-Tour-Followup,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214988060967_module_0_0_0_0,214988060967,CP-W3-Education-Lace-vs-Poly,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<table width=\""100%\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""background-color:#f9f7f4;\"">\n  <tr><td align=\""center\"" style=\""padding:32px 16px;\"">\n    <table width=\""580\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""max-width:580px;width:100%;background-color:#ffffff;border-radius:4px;overflow:hidden;\"">\n\n      <!-- HEADER -->\n      <tr><td style=\""background-color:#1a1a1a;padding:28px 40px;text-align:center;\"">\n        <span style=\""color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;\"">Hair Solutions Co.</span>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\""padding:40px;color:#1a1a1a;font-family:Georgia,'Times New Roman',serif;\"">\n        <h2 style=\""font-family:Arial,sans-serif;font-size:22px;font-weight:bold;margin:0 0 20px;color:#1a1a1a;\"">Hi {{ contact.firstname | default(\""there\"") }},</h2>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">This week, let’s talk about one of the most common questions we get: lace vs. poly bases — what’s the difference, and which is right for you?</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Lace bases are thin, breathable, and create the most natural-looking hairline, especially up close. They tend to require more frequent maintenance and are best suited to those willing to put in a bit more care.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Poly (polyurethane) bases are more durable, grip the scalp more securely, and hold up well to sweat and activity — a popular choice for active lifestyles, though the hairline can look slightly less natural in very close-up lighting.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Many of our clients land on a hybrid: lace at the front hairline for realism, poly through the rest of the base for durability. If you’re not sure which fits your life best, our team is happy to talk it through.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">&mdash; The Hair Solutions Co. Team</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\""background-color:#f9f7f4;padding:24px 40px;text-align:center;\"">\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0 0 6px;line-height:1.5;\"">Hair Solutions Co. &bull; <a href=\""https://hairsolutions.co\"" style=\""color:#999999;text-decoration:none;\"">hairsolutions.co</a></p>\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0;line-height:1.5;\"">\n          <a href=\""{{ unsubscribe_link }}\"" style=\""color:#999999;\"">Unsubscribe</a> &bull;\n          <a href=\""{{ subscription_preferences_link }}\"" style=\""color:#999999;\"">Manage preferences</a>\n        </p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>"",""lineNumber"":32,""parent_widget_container"":null,""schema_version"":2,""startPosition"":19}",e398be8184d97f7e84f5a1c65532a7b2a584f15ea8b77e099e1b17dbca82b307,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214988060967_module_1_0_0_1,214988060967,CP-W3-Education-Lace-vs-Poly,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""font"":{""color"":""{{is_ungated_for_email_branded_templates && style_settings.initial_source == \""BRANDED_TEMPLATE\"" ? style_settings.primary_font_color : \""#23496d\""}}"",""font"":""Arial, sans-serif"",""size"":{""units"":""px"",""value"":12}},""lineNumber"":61,""link_font"":{""color"":""{{is_ungated_for_email_branded_templates && style_settings.initial_source == \""BRANDED_TEMPLATE\"" ? style_settings.primary_font_color : \""#00a4bd\""}}"",""font"":""Helvetica,Arial,sans-serif"",""size"":{""units"":""px"",""value"":12},""styles"":{""bold"":false,""italic"":false,""underline"":true}},""parent_widget_container"":null,""schema_version"":2,""startPosition"":-973,""unsubscribe_link_type"":""both""}",1308b335f0e023a29469126e487a69541697de9958fbf8c8897a72940cf6208d,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214988060970_module_0_0_0_0,214988060970,CP-W4-First-Order-Offer,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p>To celebrate the relaunch of Hair Solutions Co., I'd like to offer you something special:</p>\n\n<p style=\""font-size:18px;background-color:#f8f9fa;padding:16px;border-left:4px solid #1a1a2e;\"">\n<strong>10% off your first hair system order</strong><br>\nUse code: <strong>LAUNCH10</strong> at checkout<br>\n<em>Valid for 14 days</em>\n</p>\n\n<p><strong>What makes us different:</strong></p>\n<ul>\n<li>Premium 100% human hair — hand-tied for natural movement</li>\n<li>Full tracking on every shipment</li>\n<li>Founder-managed quality — I personally oversee every order</li>\n<li>Responsive support — reply to any email and reach me directly</li>\n</ul>\n\n<p>Whether you're looking for lace, poly, hybrid, or mono — your first system is 10% off.</p>\n\n<p><a href=\""https://hairsolutions.co/collections/all?utm_source=hubspot&utm_medium=email&utm_campaign=2026-02-launch-offer&utm_content=cp-w4-offer&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">Shop Now — 10% Off →</a></p>\n\n<p>Vincent Laroche<br>\nFounder, Hair Solutions Co.</p>"",""schema_version"":2}",dbd2f3d6ac6952816ec63216996fbfede8012b90133415ea3ceef72c8c7d47b5,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
