usage_214990267405_module_1_0_0_1,214990267405,CP W18 — Spring Seasonal Promo,AUTOMATED_DRAFT,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/ecommerce/ecommerce_abandoned_cart_4.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,,module-1-0-0,,,,section-1,1,0,0,,"{""css_class"":""dnd-module"",""hs_enable_module_padding"":true,""hs_wrapper_css"":{""padding-bottom"":""28px"",""padding-left"":""40px"",""padding-right"":""40px"",""padding-top"":""16px""},""html"":""<div style=\""font-family:Helvetica Neue,Helvetica,Arial,sans-serif;line-height:150%;color:#FFFFFF;\""><h1 style=\""margin:0;font-family:Arial Black,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:52px;line-height:108%;font-weight:700;letter-spacing:-0.3px;text-align:center;color:#FFFFFF;\"">THE SPRING COLLECTION SALE.</h1><p style=\""margin:16px 0 0 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;text-align:center;color:#FFFFFF;\"">Lighter systems, lighter colors, limited time.</p></div>"",""lineNumber"":94,""parent_widget_container"":null,""schema_version"":2,""startPosition"":-442}",86623f896173ad3bd6463d913db7a8fc917834a7b642cfecceb23a0e263afff7,False,True,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267405_module_2_0_0_2,214990267405,CP W18 — Spring Seasonal Promo,AUTOMATED_DRAFT,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/ecommerce/ecommerce_abandoned_cart_4.html,builtin_hubspot_image_email,builtin_hubspot,HubSpot built-in modules,@hubspot/image_email,,module-2-0-0,,,,section-2,2,0,0,,"{""css_class"":""dnd-module"",""hs_enable_module_padding"":true,""hs_wrapper_css"":{""padding-bottom"":""20px"",""padding-left"":""20px"",""padding-right"":""20px"",""padding-top"":""20px""},""img"":{""alt"":""Man in plaid shirt and jeans with a fresh spring look (temporary — GAP-06 needs AI generation)"",""height"":320,""loading"":""disabled"",""src"":""https://res.cloudinary.com/dtmizxj1n/image/upload/w_600,h_300,c_fill,g_auto,q_auto,f_auto/v1/portrait-man-plaid-shirt-jeans"",""width"":560},""lineNumber"":61,""link"":""https://hairsolutions.co/collections/spring"",""parent_widget_container"":null,""schema_version"":2,""startPosition"":-1015}",f39aed976bffb3457acc400df259e5dd7512e97b66eb984f8b9f651f05a206c0,False,True,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267405_module_3_0_0_3,214990267405,CP W18 — Spring Seasonal Promo,AUTOMATED_DRAFT,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/ecommerce/ecommerce_abandoned_cart_4.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,,module-3-0-0,,,,section-3,3,0,0,,"{""css_class"":""dnd-module"",""hs_enable_module_padding"":true,""hs_wrapper_css"":{""padding-bottom"":""20px"",""padding-left"":""40px"",""padding-right"":""40px"",""padding-top"":""16px""},""html"":""<div style=\""font-family:Helvetica Neue,Helvetica,Arial,sans-serif;line-height:150%;color:#1A1A1A;\""><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\"">Spring is here, the weather is warming up, and your hair system should keep pace. This is the time of year when lighter bases, thinner materials, and warmer tones start to make a real difference in comfort and appearance.</p><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\"">For the next 7 days, we are offering <strong>20% off our full Spring Collection</strong> — a curated selection of systems built for the season. That includes our lightest-weight lace and hybrid bases, trending color blends with natural sun-kissed highlights, and our most breathable mono systems for all-day comfort in heat and humidity.</p><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\"">Why does this matter? Because the system that carried you through winter may not be the best choice for the months ahead. Warmer temperatures change how adhesives perform, how your scalp breathes, and how your system sits throughout the day. A lighter base with better airflow is not a luxury in spring and summer — it is a practical upgrade.</p><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\"">If you have been meaning to try a new base type, experiment with a lighter color, or simply stock up before summer travel, this is the window to do it.</p><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\"">Use code <strong>SPRING20</strong> at checkout. Sale ends Sunday at midnight. No exceptions, no extensions — once it is over, prices go back to full.</p></div>"",""lineNumber"":94,""parent_widget_container"":null,""schema_version"":2,""startPosition"":-442}",16047093b8a2b77a5226e1079c80994f5852a0be5d961572a2aa74d8de55decb,False,True,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
