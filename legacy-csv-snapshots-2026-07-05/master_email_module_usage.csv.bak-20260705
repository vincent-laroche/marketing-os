usage_214990267438_module_0_0_0_0,214990267438,Consultation Follow-Up — Day 90 (Reengagement),AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\""UTF-8\"">\n<meta name=\""viewport\"" content=\""width=device-width, initial-scale=1.0\"">\n<style>\n  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 15px; color: #333; margin: 0; padding: 0; background: #ffffff; }\n  .container { max-width: 600px; margin: 0 auto; padding: 32px 24px; }\n</style>\n</head>\n<body>\n<div class=\""container\"">\n<p style=\""margin:8px 0;line-height:1.6;\""># Consultation Follow-Up — Day 90 (Reengagement)</p>\n<hr style=\""border:none;border-top:1px solid #e0e0e0;margin:16px 0;\"">\n<p style=\""margin:8px 0;line-height:1.6;\"">Hi {{ contact.firstname }},</p>\n<p style=\""margin:8px 0;line-height:1.6;\"">It has been a few months since we spoke, and I wanted to check in.</p>\n<p style=\""margin:8px 0;line-height:1.6;\"">I know the timing was not right when we last talked. I was not sure if things had changed on your end — sometimes they do, sometimes they do not.</p>\n<p style=\""margin:8px 0;line-height:1.6;\"">If you are in a different place now and want to revisit the conversation, I am here. If not, no problem at all.</p>\n<p style=\""margin:8px 0;line-height:1.6;\"">Either way, I hope things are going well.</p>\n<p style=\""margin:8px 0;line-height:1.6;\"">Vincent Hair Solutions Co.</p>\n</div>\n</body>\n</html>"",""lineNumber"":32,""parent_widget_container"":null,""schema_version"":2,""startPosition"":19}",a701f96010dc23b3f8e44e6dd9f2b7f34372dc890b9c7370164313b3a10a371e,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267438_module_1_0_0_1,214990267438,Consultation Follow-Up — Day 90 (Reengagement),AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""font"":{""color"":""#23496d"",""font"":""Arial, sans-serif"",""size"":{""units"":""px"",""value"":12}},""lineNumber"":61,""link_font"":{""color"":""#00a4bd"",""font"":""Helvetica,Arial,sans-serif"",""size"":{""units"":""px"",""value"":12},""styles"":{""bold"":false,""italic"":false,""underline"":true}},""parent_widget_container"":null,""schema_version"":2,""startPosition"":-973,""unsubscribe_link_type"":""both""}",277c5eaa4279c1923b0318307a75e43161e7988848023244cf9fbb072fbd0f93,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267441_module_0_0_0_0,214990267441,J3-E7 — Styling and Removal,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<table width=\""100%\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""background-color:#f9f7f4;\"">\n  <tr><td align=\""center\"" style=\""padding:32px 16px;\"">\n    <table width=\""580\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""max-width:580px;width:100%;background-color:#ffffff;border-radius:4px;overflow:hidden;\"">\n\n      <!-- HEADER -->\n      <tr><td style=\""background-color:#1a1a1a;padding:28px 40px;text-align:center;\"">\n        <span style=\""color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;\"">Hair Solutions Co.</span>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\""padding:40px;color:#1a1a1a;font-family:Georgia,'Times New Roman',serif;\"">\n        <h2 style=\""font-family:Arial,sans-serif;font-size:22px;font-weight:bold;margin:0 0 20px;color:#1a1a1a;\"">Hi {{ contact.firstname | default(\""there\"") }},</h2>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">By now you’ve had some time with your system — here are a few tips on styling and removal.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">For styling, treat it much like natural hair: use lightweight products, avoid heavy oils near the base, and let it air-dry when possible to preserve the bond longer.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">When it’s time to remove, use an adhesive remover designed for hair systems rather than pulling — this protects both the base and your scalp.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Take your time with removal, work in small sections, and clean the base thoroughly before reapplying or storing it.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">&mdash; The Hair Solutions Co. Team</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\""background-color:#f9f7f4;padding:24px 40px;text-align:center;\"">\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0 0 6px;line-height:1.5;\"">Hair Solutions Co. &bull; <a href=\""https://hairsolutions.co\"" style=\""color:#999999;text-decoration:none;\"">hairsolutions.co</a></p>\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0;line-height:1.5;\"">\n          <a href=\""{{ unsubscribe_link }}\"" style=\""color:#999999;\"">Unsubscribe</a> &bull;\n          <a href=\""{{ subscription_preferences_link }}\"" style=\""color:#999999;\"">Manage preferences</a>\n        </p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>"",""schema_version"":2}",a26ba26f985bd8a22ff4ca4f57736d5097a063f3d7b5f130726bc701432d3357,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267441_module_1_0_0_1,214990267441,J3-E7 — Styling and Removal,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267444_module_0_0_0_0,214990267444,J2-E5 — Soft Consult Invite,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<table width=\""100%\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""background-color:#f9f7f4;\"">\n  <tr><td align=\""center\"" style=\""padding:32px 16px;\"">\n    <table width=\""580\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""max-width:580px;width:100%;background-color:#ffffff;border-radius:4px;overflow:hidden;\"">\n\n      <!-- HEADER -->\n      <tr><td style=\""background-color:#1a1a1a;padding:28px 40px;text-align:center;\"">\n        <span style=\""color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;\"">Hair Solutions Co.</span>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\""padding:40px;color:#1a1a1a;font-family:Georgia,'Times New Roman',serif;\"">\n        <h2 style=\""font-family:Arial,sans-serif;font-size:22px;font-weight:bold;margin:0 0 20px;color:#1a1a1a;\"">Hi {{ contact.firstname | default(\""there\"") }},</h2>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">No pitch here — just an open invitation.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">If you’ve ever had questions about hair replacement systems, whether for yourself or someone you know, we offer free, no-obligation video consultations.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">It’s a relaxed conversation: we look at your situation, answer questions honestly (including if a system isn’t the right fit), and you walk away with clearer information either way.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">If you’re curious, you can book a time whenever works for you — there’s genuinely no pressure.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">&mdash; The Hair Solutions Co. Team</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\""background-color:#f9f7f4;padding:24px 40px;text-align:center;\"">\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0 0 6px;line-height:1.5;\"">Hair Solutions Co. &bull; <a href=\""https://hairsolutions.co\"" style=\""color:#999999;text-decoration:none;\"">hairsolutions.co</a></p>\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0;line-height:1.5;\"">\n          <a href=\""{{ unsubscribe_link }}\"" style=\""color:#999999;\"">Unsubscribe</a> &bull;\n          <a href=\""{{ subscription_preferences_link }}\"" style=\""color:#999999;\"">Manage preferences</a>\n        </p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>"",""schema_version"":2}",ca20e76fa30e7ca6c9df3403f99e3028ba70c1d7e5a76e6bb7d801600058a677,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267444_module_1_0_0_1,214990267444,J2-E5 — Soft Consult Invite,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267447_module_0_0_0_0,214990267447,J8-E4 — Final Confirmation,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<table width=\""100%\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""background-color:#f9f7f4;\"">\n  <tr><td align=\""center\"" style=\""padding:32px 16px;\"">\n    <table width=\""580\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""max-width:580px;width:100%;background-color:#ffffff;border-radius:4px;overflow:hidden;\"">\n\n      <!-- HEADER -->\n      <tr><td style=\""background-color:#1a1a1a;padding:28px 40px;text-align:center;\"">\n        <span style=\""color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;\"">Hair Solutions Co.</span>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\""padding:40px;color:#1a1a1a;font-family:Georgia,'Times New Roman',serif;\"">\n        <h2 style=\""font-family:Arial,sans-serif;font-size:22px;font-weight:bold;margin:0 0 20px;color:#1a1a1a;\"">Hi {{ contact.firstname | default(\""there\"") }},</h2>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">This is just a quick confirmation — your renewal has been processed.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Your next system is now in production, using the same specifications on file from your previous order, unless you let us know otherwise.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">You’ll receive a separate email with tracking information once it ships.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Thanks for staying on schedule — it really does make a difference in keeping your look consistent.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">&mdash; The Hair Solutions Co. Team</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\""background-color:#f9f7f4;padding:24px 40px;text-align:center;\"">\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0 0 6px;line-height:1.5;\"">Hair Solutions Co. &bull; <a href=\""https://hairsolutions.co\"" style=\""color:#999999;text-decoration:none;\"">hairsolutions.co</a></p>\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0;line-height:1.5;\"">\n          <a href=\""{{ unsubscribe_link }}\"" style=\""color:#999999;\"">Unsubscribe</a> &bull;\n          <a href=\""{{ subscription_preferences_link }}\"" style=\""color:#999999;\"">Manage preferences</a>\n        </p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>"",""schema_version"":2}",63904c91198f8c890d89760a4f5bf63675ef4c38a8f337e8432aadf69d7c34ce,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267447_module_1_0_0_1,214990267447,J8-E4 — Final Confirmation,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267450_module_0_0_0_0,214990267450,J6-E4 — VIP Offer,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<table width=\""100%\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""background-color:#f9f7f4;\"">\n  <tr><td align=\""center\"" style=\""padding:32px 16px;\"">\n    <table width=\""580\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""max-width:580px;width:100%;background-color:#ffffff;border-radius:4px;overflow:hidden;\"">\n\n      <!-- HEADER -->\n      <tr><td style=\""background-color:#1a1a1a;padding:28px 40px;text-align:center;\"">\n        <span style=\""color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;\"">Hair Solutions Co.</span>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\""padding:40px;color:#1a1a1a;font-family:Georgia,'Times New Roman',serif;\"">\n        <h2 style=\""font-family:Arial,sans-serif;font-size:22px;font-weight:bold;margin:0 0 20px;color:#1a1a1a;\"">Hi {{ contact.firstname | default(\""there\"") }},</h2>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">As a thank-you for being a long-time client, we wanted to extend something just for you.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">For a limited time, loyal clients like you can take advantage of an exclusive discount on your next system or accessory order — no code needed, it’ll be applied automatically when you check out.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">This is one of the small ways we try to say thanks to the people who’ve stuck with us.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">If there’s anything else we can help with, just let us know.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">&mdash; Vincent<br>Hair Solutions Co.</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\""background-color:#f9f7f4;padding:24px 40px;text-align:center;\"">\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0 0 6px;line-height:1.5;\"">Hair Solutions Co. &bull; <a href=\""https://hairsolutions.co\"" style=\""color:#999999;text-decoration:none;\"">hairsolutions.co</a></p>\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0;line-height:1.5;\"">\n          <a href=\""{{ unsubscribe_link }}\"" style=\""color:#999999;\"">Unsubscribe</a> &bull;\n          <a href=\""{{ subscription_preferences_link }}\"" style=\""color:#999999;\"">Manage preferences</a>\n        </p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>"",""schema_version"":2}",63429f0bd29a9c495b3d034f631cfa23082e48e9091a050e9f66fb4c9be0ab14,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267450_module_1_0_0_1,214990267450,J6-E4 — VIP Offer,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267453_module_0_0_0_0,214990267453,D1 — Payment Failed,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<table width=\""100%\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""background-color:#f9f7f4;\"">\n  <tr><td align=\""center\"" style=\""padding:32px 16px;\"">\n    <table width=\""580\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""max-width:580px;width:100%;background-color:#ffffff;border-radius:4px;overflow:hidden;\"">\n\n      <!-- HEADER -->\n      <tr><td style=\""background-color:#1a1a1a;padding:28px 40px;text-align:center;\"">\n        <span style=\""color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;\"">Hair Solutions Co.</span>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\""padding:40px;color:#1a1a1a;font-family:Georgia,'Times New Roman',serif;\"">\n        <h2 style=\""font-family:Arial,sans-serif;font-size:22px;font-weight:bold;margin:0 0 20px;color:#1a1a1a;\"">Hi {{ contact.firstname | default(\""there\"") }},</h2>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">We ran into an issue processing the payment for your recent order or subscription.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">This can happen for a few common reasons — an expired card, insufficient funds, or your bank flagging the charge for review.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">No need to worry: your order or subscription is still on hold, nothing has been cancelled. You can update your payment details whenever it’s convenient, and we’ll automatically try again.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">If you have any questions or need help updating your information, just reply to this email and we’ll sort it out together.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">&mdash; The Hair Solutions Co. Team</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\""background-color:#f9f7f4;padding:24px 40px;text-align:center;\"">\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0 0 6px;line-height:1.5;\"">Hair Solutions Co. &bull; <a href=\""https://hairsolutions.co\"" style=\""color:#999999;text-decoration:none;\"">hairsolutions.co</a></p>\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0;line-height:1.5;\"">\n          <a href=\""{{ unsubscribe_link }}\"" style=\""color:#999999;\"">Unsubscribe</a> &bull;\n          <a href=\""{{ subscription_preferences_link }}\"" style=\""color:#999999;\"">Manage preferences</a>\n        </p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>"",""schema_version"":2}",746803e35d5daf3a7245cdf846a3a640aebfc53bb2353cd956f941ba2088db1a,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267453_module_1_0_0_1,214990267453,D1 — Payment Failed,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267456_module_0_0_0_0,214990267456,Consultation Follow-Up — Final Close Loop,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\""UTF-8\"">\n<meta name=\""viewport\"" content=\""width=device-width, initial-scale=1.0\"">\n<style>\n  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 15px; color: #333; margin: 0; padding: 0; background: #ffffff; }\n  .container { max-width: 600px; margin: 0 auto; padding: 32px 24px; }\n</style>\n</head>\n<body>\n<div class=\""container\"">\n<p style=\""margin:8px 0;line-height:1.6;\""># Consultation Follow-Up — Final Close Loop</p>\n<hr style=\""border:none;border-top:1px solid #e0e0e0;margin:16px 0;\"">\n<p style=\""margin:8px 0;line-height:1.6;\"">Hi {{ contact.firstname }},</p>\n<p style=\""margin:8px 0;line-height:1.6;\"">I wanted to send one final note before I stop reaching out.</p>\n<p style=\""margin:8px 0;line-height:1.6;\"">We spoke a while back and I know things did not move forward. That is completely fine — this kind of decision happens on your timeline, not mine.</p>\n<p style=\""margin:8px 0;line-height:1.6;\"">I am going to step back from following up for now. But if you ever want to revisit the conversation — whether that is next month or next year — you can always reach me directly. My door is always open.</p>\n<p style=\""margin:8px 0;line-height:1.6;\"">Wishing you well, Vincent Hair Solutions Co.</p>\n</div>\n</body>\n</html>"",""lineNumber"":32,""parent_widget_container"":null,""schema_version"":2,""startPosition"":19}",87baa34ba5805d68d807e00cca7eac8700db2f75473d2b606c797446b0108c61,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267456_module_1_0_0_1,214990267456,Consultation Follow-Up — Final Close Loop,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""font"":{""color"":""#23496d"",""font"":""Arial, sans-serif"",""size"":{""units"":""px"",""value"":12}},""lineNumber"":61,""link_font"":{""color"":""#00a4bd"",""font"":""Helvetica,Arial,sans-serif"",""size"":{""units"":""px"",""value"":12},""styles"":{""bold"":false,""italic"":false,""underline"":true}},""parent_widget_container"":null,""schema_version"":2,""startPosition"":-973,""unsubscribe_link_type"":""both""}",277c5eaa4279c1923b0318307a75e43161e7988848023244cf9fbb072fbd0f93,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267459_module_0_0_0_0,214990267459,J3-E8 — Review & Next Steps,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<table width=\""100%\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""background-color:#f9f7f4;\"">\n  <tr><td align=\""center\"" style=\""padding:32px 16px;\"">\n    <table width=\""580\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""max-width:580px;width:100%;background-color:#ffffff;border-radius:4px;overflow:hidden;\"">\n\n      <!-- HEADER -->\n      <tr><td style=\""background-color:#1a1a1a;padding:28px 40px;text-align:center;\"">\n        <span style=\""color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;\"">Hair Solutions Co.</span>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\""padding:40px;color:#1a1a1a;font-family:Georgia,'Times New Roman',serif;\"">\n        <h2 style=\""font-family:Arial,sans-serif;font-size:22px;font-weight:bold;margin:0 0 20px;color:#1a1a1a;\"">Hi {{ contact.firstname | default(\""there\"") }},</h2>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">By now you’ve had some real time with your system, and we’d love to hear how it’s going.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">If you have a couple of minutes, a short review — even a few sentences — helps other people who are considering a system for the first time. It means a lot, and we read every one.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">As for next steps: keep an eye on the wear and feel of your base over the coming weeks. We’ll send maintenance reminders and, eventually, a heads-up when it’s time to think about your next system.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Thanks again for choosing Hair Solutions Co. — we’re glad to have you with us.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">&mdash; Vincent<br>Hair Solutions Co.</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\""background-color:#f9f7f4;padding:24px 40px;text-align:center;\"">\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0 0 6px;line-height:1.5;\"">Hair Solutions Co. &bull; <a href=\""https://hairsolutions.co\"" style=\""color:#999999;text-decoration:none;\"">hairsolutions.co</a></p>\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0;line-height:1.5;\"">\n          <a href=\""{{ unsubscribe_link }}\"" style=\""color:#999999;\"">Unsubscribe</a> &bull;\n          <a href=\""{{ subscription_preferences_link }}\"" style=\""color:#999999;\"">Manage preferences</a>\n        </p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>"",""schema_version"":2}",e2a7216e25ef412d88d32d0f6ff9a7ca26c9e009247637f45cd3e1698291b523,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267459_module_1_0_0_1,214990267459,J3-E8 — Review & Next Steps,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267462_module_0_0_0_0,214990267462,J1-E3 — Base Types Educational,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<table width=\""100%\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""background-color:#f9f7f4;\"">\n  <tr><td align=\""center\"" style=\""padding:32px 16px;\"">\n    <table width=\""580\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""max-width:580px;width:100%;background-color:#ffffff;border-radius:4px;overflow:hidden;\"">\n\n      <!-- HEADER -->\n      <tr><td style=\""background-color:#1a1a1a;padding:28px 40px;text-align:center;\"">\n        <span style=\""color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;\"">Hair Solutions Co.</span>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\""padding:40px;color:#1a1a1a;font-family:Georgia,'Times New Roman',serif;\"">\n        <h2 style=\""font-family:Arial,sans-serif;font-size:22px;font-weight:bold;margin:0 0 20px;color:#1a1a1a;\"">Hi {{ contact.firstname | default(\""there\"") }},</h2>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">One of the most important choices in a hair system is the base — the foundation everything else is built on.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Lace bases are lightweight, breathable, and offer the most natural-looking hairline, but require a bit more care. Poly (polyurethane) bases are thinner, more durable, and grip well, often preferred for active lifestyles. Many systems use a combination of both, balancing realism with durability.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">There’s no single “best” option — it depends on your skin sensitivity, activity level, climate, and how natural you need the hairline to look in different lighting.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">If you’re ever unsure which is right for you, our team is happy to talk through the trade-offs based on your specific situation.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">&mdash; The Hair Solutions Co. Team</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\""background-color:#f9f7f4;padding:24px 40px;text-align:center;\"">\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0 0 6px;line-height:1.5;\"">Hair Solutions Co. &bull; <a href=\""https://hairsolutions.co\"" style=\""color:#999999;text-decoration:none;\"">hairsolutions.co</a></p>\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0;line-height:1.5;\"">\n          <a href=\""{{ unsubscribe_link }}\"" style=\""color:#999999;\"">Unsubscribe</a> &bull;\n          <a href=\""{{ subscription_preferences_link }}\"" style=\""color:#999999;\"">Manage preferences</a>\n        </p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>"",""schema_version"":2}",504964d8ecad71559e14c7f1cdcff1a894ee1a5b57c8d196fa3898b50b83c1ea,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267462_module_1_0_0_1,214990267462,J1-E3 — Base Types Educational,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214990267465_module_0_0_0_0,214990267465,J7-E3 — Specific Offer,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<table width=\""100%\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""background-color:#f9f7f4;\"">\n  <tr><td align=\""center\"" style=\""padding:32px 16px;\"">\n    <table width=\""580\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""max-width:580px;width:100%;background-color:#ffffff;border-radius:4px;overflow:hidden;\"">\n\n      <!-- HEADER -->\n      <tr><td style=\""background-color:#1a1a1a;padding:28px 40px;text-align:center;\"">\n        <span style=\""color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;\"">Hair Solutions Co.</span>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\""padding:40px;color:#1a1a1a;font-family:Georgia,'Times New Roman',serif;\"">\n        <h2 style=\""font-family:Arial,sans-serif;font-size:22px;font-weight:bold;margin:0 0 20px;color:#1a1a1a;\"">Hi {{ contact.firstname | default(\""there\"") }},</h2>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Following up on my last note — I wanted to make it a little easier to come back, if you’re interested.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">For a limited time, we’re offering a discount on your next order, whether that’s a new system, a replacement, or just maintenance products.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">There’s no catch and no pressure — just a straightforward way to pick back up if the timing is right for you.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">If now isn’t the right time, that’s completely fine too. We’ll still be here when you’re ready.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">&mdash; Vincent<br>Hair Solutions Co.</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\""background-color:#f9f7f4;padding:24px 40px;text-align:center;\"">\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0 0 6px;line-height:1.5;\"">Hair Solutions Co. &bull; <a href=\""https://hairsolutions.co\"" style=\""color:#999999;text-decoration:none;\"">hairsolutions.co</a></p>\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0;line-height:1.5;\"">\n          <a href=\""{{ unsubscribe_link }}\"" style=\""color:#999999;\"">Unsubscribe</a> &bull;\n          <a href=\""{{ subscription_preferences_link }}\"" style=\""color:#999999;\"">Manage preferences</a>\n        </p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>"",""schema_version"":2}",0b1ee28e1762223102c8b71ecd1c4723f2ecda2e9035600cb8d79580ba3ac350,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
