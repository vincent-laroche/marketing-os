usage_214988061048_module_0_0_0_0,214988061048,J8-E3 — 7-Day Urgency,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<table width=\""100%\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""background-color:#f9f7f4;\"">\n  <tr><td align=\""center\"" style=\""padding:32px 16px;\"">\n    <table width=\""580\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""max-width:580px;width:100%;background-color:#ffffff;border-radius:4px;overflow:hidden;\"">\n\n      <!-- HEADER -->\n      <tr><td style=\""background-color:#1a1a1a;padding:28px 40px;text-align:center;\"">\n        <span style=\""color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;\"">Hair Solutions Co.</span>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\""padding:40px;color:#1a1a1a;font-family:Georgia,'Times New Roman',serif;\"">\n        <h2 style=\""font-family:Arial,sans-serif;font-size:22px;font-weight:bold;margin:0 0 20px;color:#1a1a1a;\"">Hi {{ contact.firstname | default(\""there\"") }},</h2>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Just a quick heads-up — you have about 7 days left on your current renewal window.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">If you’d like to lock in your usual pricing and avoid a gap between systems, now’s a good time to confirm your reorder.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">As a thank-you for staying on schedule, we’re including a complimentary maintenance kit with any renewal placed this week.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">If you’ve already taken care of this, feel free to ignore this note — and thank you for being on top of it.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">&mdash; The Hair Solutions Co. Team</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\""background-color:#f9f7f4;padding:24px 40px;text-align:center;\"">\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0 0 6px;line-height:1.5;\"">Hair Solutions Co. &bull; <a href=\""https://hairsolutions.co\"" style=\""color:#999999;text-decoration:none;\"">hairsolutions.co</a></p>\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0;line-height:1.5;\"">\n          <a href=\""{{ unsubscribe_link }}\"" style=\""color:#999999;\"">Unsubscribe</a> &bull;\n          <a href=\""{{ subscription_preferences_link }}\"" style=\""color:#999999;\"">Manage preferences</a>\n        </p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>"",""schema_version"":2}",c1338447e94acef2e6a14ca6011986267c1e409ec39e7c1a53e9545b500e54fd,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
