usage_214988406453_module_7_0_0_9,214988406453,CP W9 — Product Spotlight,AUTOMATED_DRAFT,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/ecommerce/ecommerce_abandoned_cart_4.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,,module-7-0-0,,,,section-7,7,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""display"":""default"",""font"":{""color"":""{{is_ungated_for_email_branded_templates && style_settings.initial_source == 'BRANDED_TEMPLATE' ? style_settings.secondary_font_color : '#757575'}}"",""font"":""Lato,Tahoma,sans-serif"",""font_set"":""DEFAULT"",""size"":{""units"":""px"",""value"":15}},""footer_html"":""<p style=\""text-align: center; font-size: 16px; line-height: 125%;\""><span style=\""font-family: Lato, Tahoma, sans-serif; color: #FFFFFF;\"">{{site_settings.company_name}}, {{site_settings.company_street_address_1}}, {{site_settings.company_street_address_2}},{{site_settings.company_city}}, {{site_settings.company_state}}</span></p>\n<p><span style=\""font-family: Lato, Tahoma, sans-serif; color: #FFFFFF;\""> </span></p>\n<p style=\""text-align: center; font-size: 18px; line-height: 125%;\""><span style=\""font-family: Lato, Tahoma, sans-serif; color: #FFFFFF;\"">&nbsp;</span></p>\n<p><span style=\""font-family: Lato, Tahoma, sans-serif; color: #FFFFFF;\""> </span></p>\n<p style=\""font-size: 15px; line-height: 125%; text-align: center;\""><span style=\""font-family: Lato, Tahoma, sans-serif; color: #FFFFFF;\""><a href=\""{{ unsubscribe_link_all }}\"" style=\""color: #FFFFFF;\"" data-unsubscribe=\""true\"">Unsubscribe</a> &nbsp;&nbsp; <a href=\""{{ unsubscribe_link }}\"" style=\""color: #FFFFFF;\"" data-unsubscribe=\""true\"">Manage preferences</a></span></p>\n<p style=\""font-size: 12px; line-height: 125%; text-align: center;\""><span style=\""color: #FFFFFF;\"">&nbsp;</span></p>"",""hs_enable_module_padding"":true,""hs_wrapper_css"":{""padding-bottom"":""28px"",""padding-left"":""10px"",""padding-right"":""10px"",""padding-top"":""0px""},""lineNumber"":326,""link_font"":{""color"":""{{is_ungated_for_email_branded_templates && style_settings.initial_source == 'BRANDED_TEMPLATE' ? style_settings.secondary_font_color : '#757575'}}"",""font"":""Lato,Tahoma,sans-serif"",""font_set"":""DEFAULT"",""size"":{""units"":""px"",""value"":15},""styles"":{""bold"":false,""italic"":false,""underline"":true}},""parent_widget_container"":null,""schema_version"":2,""startPosition"":-480,""unsubscribe_link_type"":""both""}",4664f2874e88e860249604d3bbafdc8f1b59f326500ccb4924d9fc9f63916122,False,True,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746959_module_0_0_0_0,214989746959,WF-AbandonedCart-01-Gentle-Reminder,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p>It looks like you were checking out a hair system but didn't complete your order.</p>\n\n<p>No pressure at all — I just wanted to make sure nothing went wrong on our end.</p>\n\n<p>Your cart is saved and ready whenever you are:</p>\n\n<p><a href=\""https://hairsolutions.co/cart?utm_source=hubspot&utm_medium=email&utm_campaign=abandoned-cart&utm_content=wf-cart-01&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">Complete Your Order →</a></p>\n\n<p>If you had any questions about the product, sizing, or shipping — just reply to this email and I'll help you out personally.</p>\n\n<p>Vincent</p>"",""schema_version"":2}",d3e4986f1fd636e6acf19a6d4ee6e5a7e30317e8b6606c95ddabe5d97dccde5c,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746959_module_1_0_0_1,214989746959,WF-AbandonedCart-01-Gentle-Reminder,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746962_module_0_0_0_0,214989746962,WF-CrossSell-02-Problem-Solution,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p>Want to know the single biggest mistake that shortens a hair system's lifespan?</p>\n\n<p><strong>Using the wrong adhesive — or no adhesive remover.</strong></p>\n\n<p>Here's what happens:</p>\n\n<p>❌ Wrong adhesive → weak bond → system shifts → edges lift → premature wear<br>\n❌ No proper remover → pulling on the base → stretching and tearing → system ruined early<br>\n❌ No scalp prep → oils block adhesion → system won't hold → frustration</p>\n\n<p><strong>The fix is simple:</strong></p>\n\n<p>✅ Match your adhesive to your base type and activity level<br>\n✅ Always use a proper remover — never just pull<br>\n✅ Clean your scalp before every reattachment</p>\n\n<p>The right products can extend your system's life by 30-50%. That's real money saved.</p>\n\n<p><a href=\""https://hairsolutions.co/collections/maintenance?utm_source=hubspot&utm_medium=email&utm_campaign=cross-sell&utm_content=wf-crosssell-02&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">Protect Your Investment →</a></p>\n\n<p>Vincent</p>"",""schema_version"":2}",f3c6bc479de4624b876c403e95be87a4d2e0b5712885488dd231a749b50e0207,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746962_module_1_0_0_1,214989746962,WF-CrossSell-02-Problem-Solution,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746965_module_0_0_0_0,214989746965,WF-CrossSell-03-Bundle-Offer,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p>I put together a special offer for customers who've recently purchased a hair system.</p>\n\n<p style=\""font-size:18px;background-color:#f8f9fa;padding:16px;border-left:4px solid #1a1a2e;\"">\n<strong>15% off any maintenance products</strong><br>\nUse code: <strong>CARE15</strong> at checkout<br>\n<em>Valid for 7 days</em>\n</p>\n\n<p><strong>Most popular maintenance bundle:</strong></p>\n<ul>\n<li>Adhesive or tape (your choice)</li>\n<li>Adhesive remover</li>\n<li>Scalp cleanser</li>\n<li>Sulfate-free shampoo</li>\n</ul>\n\n<p>This bundle covers everything you need for 4-6 weeks of proper maintenance.</p>\n\n<p><a href=\""https://hairsolutions.co/collections/maintenance?utm_source=hubspot&utm_medium=email&utm_campaign=cross-sell&utm_content=wf-crosssell-03&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">Get the Care Bundle — 15% Off →</a></p>\n\n<p>Taking care of your system now saves you money later. A well-maintained system lasts significantly longer.</p>\n\n<p>Vincent</p>"",""schema_version"":2}",2a270e81b018c94a52a052ee0db459b69945fb32d03f9264a12583671da601f4,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746965_module_1_0_0_1,214989746965,WF-CrossSell-03-Bundle-Offer,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746968_module_0_0_0_0,214989746968,WF-NewCustomer-01-Order-Confirmation,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p><strong>Great news — your order has been confirmed!</strong></p>\n\n<p>Thank you for trusting Hair Solutions Co. with your purchase. I want you to know that I personally review every order that comes in, and yours is no exception.</p>\n\n<p><strong>What happens next:</strong></p>\n<ol>\n<li><strong>Production begins</strong> — Your system enters production within 24 hours</li>\n<li><strong>Quality check</strong> — Every unit is inspected before shipping</li>\n<li><strong>Shipping + tracking</strong> — You'll receive a tracking number the moment it ships</li>\n<li><strong>Delivery</strong> — Typical delivery in 10-20 business days</li>\n</ol>\n\n<p>I'll keep you updated along the way. You'll never have to wonder where your order is.</p>\n\n<p><a href=\""https://hairsolutions.co/account?utm_source=hubspot&utm_medium=email&utm_campaign=new-customer-flow&utm_content=wf-newcust-01&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">Track Your Order →</a></p>\n\n<p>Questions? Reply to this email — it comes directly to me.</p>\n\n<p>Thank you again,<br>\nVincent Laroche<br>\nFounder, Hair Solutions Co.</p>"",""schema_version"":2}",7be1ba3ffda252ba899f9f5b786c4dc6afc7ffeaaae44a98eb8ddcf72a41007c,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746968_module_1_0_0_1,214989746968,WF-NewCustomer-01-Order-Confirmation,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746971_module_0_0_0_0,214989746971,WF-NewCustomer-02-Prep-Guide,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p>Your hair system is currently in production, and I want to make sure you're fully prepared for when it arrives.</p>\n\n<p><strong>🧰 What you'll need:</strong></p>\n<ul>\n<li>Adhesive or tape (we recommend starting with tape for easier application)</li>\n<li>Scalp cleanser/prep solution</li>\n<li>A mirror and good lighting</li>\n<li>About 30-45 minutes for your first application</li>\n</ul>\n\n<p><strong>🪒 Prepare your scalp:</strong></p>\n<ul>\n<li>Clean the application area thoroughly</li>\n<li>If you have existing hair in the area, trim it short or shave for best adhesion</li>\n<li>Make sure the skin is dry and free of oils</li>\n</ul>\n\n<p><strong>📹 Watch before your system arrives:</strong><br>\nWe've put together a step-by-step preparation guide that walks you through everything — from unboxing to your first application.</p>\n\n<p><a href=\""https://hairsolutions.co/blogs/guides/preparation-guide?utm_source=hubspot&utm_medium=email&utm_campaign=new-customer-flow&utm_content=wf-newcust-02&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">Read the Prep Guide →</a></p>\n\n<p>Don't have adhesive or tape yet? We carry everything you need:</p>\n\n<p><a href=\""https://hairsolutions.co/collections/maintenance?utm_source=hubspot&utm_medium=email&utm_campaign=new-customer-flow&utm_content=wf-newcust-02&utm_term=secondary-cta\"" style=\""color:#1a1a2e;font-weight:bold;\"">Shop Maintenance Essentials →</a></p>\n\n<p>Vincent</p>"",""schema_version"":2}",a20bbc2590b3cf75960f151f00a54e5e608cf624fc62bc0791458b8892918a5c,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746971_module_1_0_0_1,214989746971,WF-NewCustomer-02-Prep-Guide,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746974_module_0_0_0_0,214989746974,WF-PostPurchase-01-Delivery-QuickStart,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p><strong>Your hair system should be with you now — congratulations!</strong></p>\n\n<p>I know that first application can feel a bit nerve-wracking, so here's a quick-start guide to get you going:</p>\n\n<p><strong>Step 1: Unbox and inspect</strong><br>\nCarefully remove the system from packaging. Check that the color, density, and base match your order. If anything looks off, reply to me immediately.</p>\n\n<p><strong>Step 2: Prepare your scalp</strong><br>\nClean the application area with scalp cleanser. Make sure the skin is completely dry and oil-free.</p>\n\n<p><strong>Step 3: Apply adhesive</strong><br>\nApply your chosen adhesive (tape or liquid) to the base perimeter. For tape, apply strips to the system. For liquid, apply a thin layer and let it get tacky.</p>\n\n<p><strong>Step 4: Position and press</strong><br>\nStart at the front hairline and gently press back. Use a mirror to align. Press firmly for 30 seconds across the entire base.</p>\n\n<p><strong>Step 5: Style</strong><br>\nCut, style, and blend as needed. Your system can be cut by any barber or stylist.</p>\n\n<p><a href=\""https://hairsolutions.co/blogs/guides/installation-guide?utm_source=hubspot&utm_medium=email&utm_campaign=post-purchase&utm_content=wf-postpurchase-01&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">Watch Full Installation Guide →</a></p>\n\n<p>If you run into any issues at all, reply to this email. I'm here to help.</p>\n\n<p>Vincent</p>"",""schema_version"":2}",025d5f3921a1d4b2d212bcd760329aa521a2010a2665bd9b9eb85ed86a08077a,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746974_module_1_0_0_1,214989746974,WF-PostPurchase-01-Delivery-QuickStart,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746977_module_0_0_0_0,214989746977,WF-PostPurchase-02-Maintenance-Schedule,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p>Now that you've been wearing your system for about a week, I wanted to share the maintenance schedule that keeps your system looking fresh and lasting as long as possible.</p>\n\n<p><strong>📅 Every 5-7 days: Quick Wash</strong></p>\n<ul>\n<li>Wash with sulfate-free shampoo</li>\n<li>Light conditioner (avoid the base area)</li>\n<li>Air dry when possible — low heat if needed</li>\n</ul>\n\n<p><strong>📅 Every 2-4 weeks: Reattachment</strong></p>\n<ul>\n<li>Remove the system carefully with adhesive remover</li>\n<li>Clean your scalp and the base thoroughly</li>\n<li>Apply fresh adhesive and reattach</li>\n</ul>\n\n<p><strong>📅 Every 30 days: Deep Clean</strong></p>\n<ul>\n<li>Full removal and deep conditioning treatment</li>\n<li>Inspect the base for any wear</li>\n<li>Check your adhesive supply — time to restock?</li>\n</ul>\n\n<p><strong>📅 Every 60-90 days: Professional Check</strong></p>\n<ul>\n<li>Consider a professional trim and restyle</li>\n<li>Evaluate if the system needs replacement (typical lifespan: 3-6 months depending on base type)</li>\n</ul>\n\n<p><strong>Running low on supplies?</strong></p>\n\n<p><a href=\""https://hairsolutions.co/collections/maintenance?utm_source=hubspot&utm_medium=email&utm_campaign=post-purchase&utm_content=wf-postpurchase-02&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">Shop Maintenance Products →</a></p>\n\n<p>Vincent</p>"",""schema_version"":2}",24a37fe51742e916e5e3a77804826f0e1ec48cb74a824c2f214380224a9f59f8,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746977_module_1_0_0_1,214989746977,WF-PostPurchase-02-Maintenance-Schedule,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746980_module_footer_block_1,214989746980,WF-PostPurchase-03-Longevity-Tips,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/ecommerce/ecommerce_abandoned_cart_4.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module_footer_block,module_footer_block,module,1,section_footer_block,9,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746983_module_0_0_0_0,214989746983,WF-Reorder-01-Friendly-Reminder,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p>It's been about 6 weeks since your last maintenance product order — which means you're probably running low.</p>\n\n<p>Running out of adhesive or remover mid-reattachment is no fun. A quick reorder now keeps your routine uninterrupted.</p>\n\n<p><a href=\""https://hairsolutions.co/collections/maintenance?utm_source=hubspot&utm_medium=email&utm_campaign=reorder-flow&utm_content=wf-reorder-01&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">Reorder Now →</a></p>\n\n<p>If your needs have changed — different adhesive type, different quantity — just reply and I'll help you find the right products.</p>\n\n<p>Vincent</p>"",""schema_version"":2}",6219ebcef1d6a2ce7403119e10242da733988e3b7ca7cebbd9d380cf0b73bfa9,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746983_module_1_0_0_1,214989746983,WF-Reorder-01-Friendly-Reminder,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746986_module_0_0_0_0,214989746986,WF-Reorder-02-Subscription-Pitch,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p>Tired of remembering to reorder your maintenance supplies?</p>\n\n<p>We're working on an auto-reorder option that will deliver your products on your schedule — so you never run out.</p>\n\n<p>In the meantime, here's a quick tip: <strong>order a 2-month supply</strong> instead of 1 month. It's more convenient, and you'll always have backup.</p>\n\n<p><a href=\""https://hairsolutions.co/collections/maintenance?utm_source=hubspot&utm_medium=email&utm_campaign=reorder-flow&utm_content=wf-reorder-02&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">Reorder Now →</a></p>\n\n<p>If you'd like to be notified when auto-reorder launches, just reply \""interested\"" and I'll add you to the list.</p>\n\n<p>Vincent</p>"",""schema_version"":2}",4058bc11f1cbdf311ce3e1b4aa01bd057a0ab2f19734e427377692ae655d425d,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746986_module_1_0_0_1,214989746986,WF-Reorder-02-Subscription-Pitch,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746989_module_0_0_0_0,214989746989,WF-Review-01-Review-Request,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p>It's been about a month since you received your hair system, and I'd love to know — <strong>how's it going?</strong></p>\n\n<p>Your honest feedback helps me in two important ways:</p>\n\n<p>1. It helps me improve our products and service<br>\n2. It helps other guys who are on the fence about taking the same step you did</p>\n\n<p>Would you take 30 seconds to leave a quick review?</p>\n\n<p><a href=\""https://hairsolutions.co/pages/reviews?utm_source=hubspot&utm_medium=email&utm_campaign=review-flow&utm_content=wf-review-01&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">Leave a Quick Review →</a></p>\n\n<p><strong>As a thank you</strong>, every review this month enters you into our monthly giveaway for a free maintenance kit (valued at $50+).</p>\n\n<p>And if something isn't right with your system — please tell me directly by replying here. I'd rather fix it than have you unhappy.</p>\n\n<p>Thanks for being part of the Hair Solutions Co. community.</p>\n\n<p>Vincent</p>"",""schema_version"":2}",322eb04da6a2ee3b64ed1e43f99720b8984abd6af177576e2d5991dfb83d0386,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746989_module_1_0_0_1,214989746989,WF-Review-01-Review-Request,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746992_module_0_0_0_0,214989746992,WF-Shipping-01-What-Happens-Next,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p>Thank you for your order! I want to give you full visibility into what happens next so there are no surprises.</p>\n\n<p><strong>Your order timeline:</strong></p>\n\n<p>📦 <strong>Day 1-2: Order processing</strong><br>\nYour order is reviewed and sent to our production team.</p>\n\n<p>🔨 <strong>Day 3-10: Production</strong><br>\nYour hair system is crafted to your exact specifications — base type, size, hair color, density, and length.</p>\n\n<p>✅ <strong>Day 10-12: Quality inspection</strong><br>\nEvery unit is inspected before shipping. If anything doesn't meet our standards, it goes back to production.</p>\n\n<p>✈️ <strong>Day 12-20: Shipping</strong><br>\nYour system ships with full tracking. You'll receive your tracking number by email as soon as it's dispatched.</p>\n\n<p>🏠 <strong>Day 15-25: Delivery</strong><br>\nEstimated total time from order to delivery: 15-25 business days. Custom orders may take slightly longer.</p>\n\n<p><strong>You will receive:</strong></p>\n<ul>\n<li>A tracking number as soon as your order ships</li>\n<li>Email updates at key milestones</li>\n<li>Direct access to me if you have any questions</li>\n</ul>\n\n<p>I personally track every order. You're not just a number here.</p>\n\n<p><a href=\""https://hairsolutions.co/pages/our-process?utm_source=hubspot&utm_medium=email&utm_campaign=shipping-flow&utm_content=wf-shipping-01&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">Learn About Our Process →</a></p>\n\n<p>Vincent</p>"",""schema_version"":2}",5f88c66a62239f8ab6c0cd411130d340aed09f972e38a4b50ed9207ffe47bd0b,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746992_module_1_0_0_1,214989746992,WF-Shipping-01-What-Happens-Next,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746995_module_0_0_0_0,214989746995,WF-Shipping-02-Mid-Wait-CheckIn,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p>Your order is currently in production, and I wanted to give you a behind-the-scenes look at the craftsmanship going into your system.</p>\n\n<p><strong>What's happening right now:</strong></p>\n\n<p>Every hair system we produce goes through a multi-step process that ensures quality and consistency:</p>\n\n<p>🔹 <strong>Base construction</strong> — Your base is cut and prepared to your exact measurements. Whether it's lace, poly, or hybrid, each base material is selected for durability and comfort.</p>\n\n<p>🔹 <strong>Hair selection</strong> — 100% human hair is selected and color-matched to your specifications. We match for color, texture, and wave pattern.</p>\n\n<p>🔹 <strong>Hand-tying</strong> — Hair is individually knotted into the base by skilled technicians. This is what creates the natural look and movement.</p>\n\n<p>🔹 <strong>Finishing</strong> — The completed system is washed, styled, and inspected. Any unit that doesn't pass gets reworked.</p>\n\n<p>This is why we don't rush production — the result is a system that looks and feels natural from day one.</p>\n\n<p><a href=\""https://hairsolutions.co/pages/quality-standards?utm_source=hubspot&utm_medium=email&utm_campaign=shipping-flow&utm_content=wf-shipping-02&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">Learn About Our Quality Standards →</a></p>\n\n<p>Your tracking number will be emailed to you as soon as your system ships. Hang tight — it'll be worth the wait.</p>\n\n<p>Vincent</p>"",""schema_version"":2}",2bdb71da0a853d6eb1a195f5c4099ce4933718bbe72c579b731893079af0f1b8,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746995_module_1_0_0_1,214989746995,WF-Shipping-02-Mid-Wait-CheckIn,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746998_module_0_0_0_0,214989746998,WF-Welcome-03-Social-Proof,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p>Choosing a hair system is a big decision — and nothing speaks louder than real results from real people.</p>\n\n<p>Here's what some of our customers have shared:</p>\n\n<p><em>\""I was nervous about trying a system for the first time, but the quality blew me away. It looks completely natural.\""</em><br>\n— <strong>M.R., first-time buyer</strong></p>\n\n<p><em>\""I've tried systems from three different companies. Hair Solutions Co. is the only one I'd recommend to a friend.\""</em><br>\n— <strong>A.T., repeat customer</strong></p>\n\n<p><em>\""The difference in my confidence is unbelievable. I wish I'd done this years ago.\""</em><br>\n— <strong>J.K., loyal customer</strong></p>\n\n<p>Every system we sell is crafted from premium human hair with meticulous attention to density, color matching, and base construction.</p>\n\n<p><a href=\""https://hairsolutions.co/pages/transformations?utm_source=hubspot&utm_medium=email&utm_campaign=welcome-flow&utm_content=wf-welcome-03&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">View Transformations →</a></p>\n\n<p>Best,<br>\nVincent</p>"",""schema_version"":2}",72fc37d24de6f9860aa219df7cd411816af5db581852965bce8749d7bcc052c7,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989746998_module_1_0_0_1,214989746998,WF-Welcome-03-Social-Proof,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989747001_module_0_0_0_0,214989747001,WF-Winback-01-Soft-CheckIn,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p>It's been a little while since we last heard from you, and I just wanted to check in.</p>\n\n<p>How's your hair system holding up? Are you due for a replacement, or is everything still going strong?</p>\n\n<p>A lot has been happening at Hair Solutions Co.:</p>\n\n<ul>\n<li>New products and base types added to the collection</li>\n<li>Improved shipping with full tracking on every order</li>\n<li>Enhanced customer service — I personally respond to every inquiry</li>\n</ul>\n\n<p>No sales pitch here. I genuinely want to know how you're doing.</p>\n\n<p><a href=\""https://hairsolutions.co?utm_source=hubspot&utm_medium=email&utm_campaign=winback-flow&utm_content=wf-winback-01&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">Browse What's New →</a></p>\n\n<p>Reply any time — I'd love to hear from you.</p>\n\n<p>Vincent</p>"",""schema_version"":2}",ef70f58c6e838385491bacce478e6697937a8062592b97e7d1eaf1d2c4e71b43,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989747001_module_1_0_0_1,214989747001,WF-Winback-01-Soft-CheckIn,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989747004_module_0_0_0_0,214989747004,WF-Winback-04-Final-Goodbye,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<p>Hi {{ personalization_token(\""contact.firstname\"", \""there\"") }},</p>\n\n<p>This is my last email in this series, and I want to respect your inbox.</p>\n\n<p>Your <strong>15% off code (COMEBACK15)</strong> expires in 7 days. After that, I won't send you any more promotional emails unless you reach out.</p>\n\n<p><a href=\""https://hairsolutions.co/collections/all?utm_source=hubspot&utm_medium=email&utm_campaign=winback-flow&utm_content=wf-winback-04&utm_term=hero-cta\"" style=\""background-color:#1a1a2e;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;\"">Shop Now — 15% Off →</a></p>\n\n<p>If you'd like to keep hearing from us but less frequently, you can update your preferences below.</p>\n\n<p>And if you'd like to unsubscribe entirely, I understand — no hard feelings.</p>\n\n<p>Either way, thank you for being a customer. If you ever need a hair system in the future, we'll be here.</p>\n\n<p>Take care,<br>\nVincent Laroche<br>\nFounder, Hair Solutions Co.</p>\n\n<p style=\""font-size:12px;color:#666;\"">\n<a href=\""https://hairsolutions.co/preferences?utm_source=hubspot&utm_medium=email&utm_campaign=winback-flow&utm_content=wf-winback-04&utm_term=preferences\"">Update your email preferences</a>\n</p>"",""schema_version"":2}",b65a4b7287ad02b7ecc9177ec45c315d52b8df672f94a6c4efaa51e7cd2ef82a,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989747004_module_1_0_0_1,214989747004,WF-Winback-04-Final-Goodbye,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989747024_module_0_0_0_0,214989747024,J6-E3 — Peace of Mind,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<table width=\""100%\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""background-color:#f9f7f4;\"">\n  <tr><td align=\""center\"" style=\""padding:32px 16px;\"">\n    <table width=\""580\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""max-width:580px;width:100%;background-color:#ffffff;border-radius:4px;overflow:hidden;\"">\n\n      <!-- HEADER -->\n      <tr><td style=\""background-color:#1a1a1a;padding:28px 40px;text-align:center;\"">\n        <span style=\""color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;\"">Hair Solutions Co.</span>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\""padding:40px;color:#1a1a1a;font-family:Georgia,'Times New Roman',serif;\"">\n        <h2 style=\""font-family:Arial,sans-serif;font-size:22px;font-weight:bold;margin:0 0 20px;color:#1a1a1a;\"">Hi {{ contact.firstname | default(\""there\"") }},</h2>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">We wanted to take a moment to remind you of something simple: we stand behind what we make.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Every system from Hair Solutions Co. comes with our quality guarantee. If something isn’t right — fit, color match, or craftsmanship — let us know and we’ll make it right.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">This applies whether you ordered last week or several months ago. We’d rather fix an issue than have you live with it.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">We hope you never need this, but we want you to know it’s there.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">&mdash; The Hair Solutions Co. Team</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\""background-color:#f9f7f4;padding:24px 40px;text-align:center;\"">\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0 0 6px;line-height:1.5;\"">Hair Solutions Co. &bull; <a href=\""https://hairsolutions.co\"" style=\""color:#999999;text-decoration:none;\"">hairsolutions.co</a></p>\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0;line-height:1.5;\"">\n          <a href=\""{{ unsubscribe_link }}\"" style=\""color:#999999;\"">Unsubscribe</a> &bull;\n          <a href=\""{{ subscription_preferences_link }}\"" style=\""color:#999999;\"">Manage preferences</a>\n        </p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>"",""schema_version"":2}",0dbccfeacc8dccd743020d6a0cd24007a0d5154719026a93c4dea125ad22a001,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989747024_module_1_0_0_1,214989747024,J6-E3 — Peace of Mind,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_email_footer,builtin_hubspot,HubSpot built-in modules,@hubspot/email_footer,2869621,module-1-0-0,module-1-0-0,module,3,section-1,1,0,0,,"{""align"":""center"",""css_class"":""dnd-module"",""schema_version"":2,""unsubscribe_link_type"":""both""}",65f51654842a159a280c79991bdb93885f67a22e4d72fba65d1b065e04027944,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214989747027_module_0_0_0_0,214989747027,J5-E2 — Artisan Update,AUTOMATED,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/dnd/plain_text.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,1155639,module-0-0-0,module-0-0-0,module,2,section-0,0,0,0,,"{""css_class"":""dnd-module"",""html"":""<table width=\""100%\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""background-color:#f9f7f4;\"">\n  <tr><td align=\""center\"" style=\""padding:32px 16px;\"">\n    <table width=\""580\"" cellpadding=\""0\"" cellspacing=\""0\"" border=\""0\"" style=\""max-width:580px;width:100%;background-color:#ffffff;border-radius:4px;overflow:hidden;\"">\n\n      <!-- HEADER -->\n      <tr><td style=\""background-color:#1a1a1a;padding:28px 40px;text-align:center;\"">\n        <span style=\""color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;\"">Hair Solutions Co.</span>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\""padding:40px;color:#1a1a1a;font-family:Georgia,'Times New Roman',serif;\"">\n        <h2 style=\""font-family:Arial,sans-serif;font-size:22px;font-weight:bold;margin:0 0 20px;color:#1a1a1a;\"">Hi {{ contact.firstname | default(\""there\"") }},</h2>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">We wanted to share a bit about how your system actually comes together.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">Each piece is hand-knotted by skilled artisans, strand by strand, onto a custom base built to your measurements. It’s slow, detailed work — a single system can take many hours of hand-knotting alone.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">We’ve recently refined parts of this process to improve durability and natural movement, based on feedback from clients just like you.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">It’s easy to take this kind of craftsmanship for granted once it’s on your head — but we think it’s worth knowing what goes into it.</p>\n<p style=\""font-size:16px;line-height:1.7;margin:0 0 18px;color:#333333;\"">&mdash; The Hair Solutions Co. Team</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\""background-color:#f9f7f4;padding:24px 40px;text-align:center;\"">\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0 0 6px;line-height:1.5;\"">Hair Solutions Co. &bull; <a href=\""https://hairsolutions.co\"" style=\""color:#999999;text-decoration:none;\"">hairsolutions.co</a></p>\n        <p style=\""font-family:Arial,sans-serif;font-size:12px;color:#999999;margin:0;line-height:1.5;\"">\n          <a href=\""{{ unsubscribe_link }}\"" style=\""color:#999999;\"">Unsubscribe</a> &bull;\n          <a href=\""{{ subscription_preferences_link }}\"" style=\""color:#999999;\"">Manage preferences</a>\n        </p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>"",""schema_version"":2}",9c9a884393adad7cee0edf978c522fb4b0aa4b10eeb6657b0046d0f713cbbc92,True,False,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
