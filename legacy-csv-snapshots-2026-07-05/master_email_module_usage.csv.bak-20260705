usage_214988060985_module_1_0_0_1,214988060985,CP W17 — Newsletter Customer Spotlight,AUTOMATED_DRAFT,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/ecommerce/ecommerce_abandoned_cart_4.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,,module-1-0-0,,,,section-1,1,0,0,,"{""css_class"":""dnd-module"",""hs_enable_module_padding"":true,""hs_wrapper_css"":{""padding-bottom"":""28px"",""padding-left"":""40px"",""padding-right"":""40px"",""padding-top"":""16px""},""html"":""<div style=\""font-family:Helvetica Neue,Helvetica,Arial,sans-serif;line-height:150%;color:#FFFFFF;\""><h1 style=\""margin:0;font-family:Arial Black,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:52px;line-height:108%;font-weight:700;letter-spacing:-0.3px;text-align:center;color:#FFFFFF;\"">THE APRIL UPDATE.</h1><p style=\""margin:16px 0 0 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;text-align:center;color:#FFFFFF;\"">A customer story that might sound familiar.</p></div>"",""lineNumber"":94,""parent_widget_container"":null,""schema_version"":2,""startPosition"":-442}",017e7b761215bf56d3cece06c469dc98a83e0ba08ff09898dbae5f8a0946187d,False,True,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214988060985_module_2_0_0_2,214988060985,CP W17 — Newsletter Customer Spotlight,AUTOMATED_DRAFT,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/ecommerce/ecommerce_abandoned_cart_4.html,builtin_hubspot_image_email,builtin_hubspot,HubSpot built-in modules,@hubspot/image_email,,module-2-0-0,,,,section-2,2,0,0,,"{""css_class"":""dnd-module"",""hs_enable_module_padding"":true,""hs_wrapper_css"":{""padding-bottom"":""20px"",""padding-left"":""20px"",""padding-right"":""20px"",""padding-top"":""20px""},""img"":{""alt"":""Danny, a Hair Solutions Co. customer, showcasing his natural-looking hair system"",""height"":320,""loading"":""disabled"",""src"":""https://res.cloudinary.com/dtmizxj1n/image/upload/w_600,h_300,c_fill,g_auto,q_auto,f_auto/v1/Danny_Rolling"",""width"":560},""lineNumber"":61,""link"":""https://hairsolutions.co/blogs/community"",""parent_widget_container"":null,""schema_version"":2,""startPosition"":-1015}",6e116db5efdbeb3ec75b870b630f6f94399dd84503b215e1cdbfe932ce5df728,False,True,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214988060985_module_3_0_0_3,214988060985,CP W17 — Newsletter Customer Spotlight,AUTOMATED_DRAFT,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/ecommerce/ecommerce_abandoned_cart_4.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,,module-3-0-0,,,,section-3,3,0,0,,"{""css_class"":""dnd-module"",""hs_enable_module_padding"":true,""hs_wrapper_css"":{""padding-bottom"":""20px"",""padding-left"":""40px"",""padding-right"":""40px"",""padding-top"":""16px""},""html"":""<div style=\""font-family:Helvetica Neue,Helvetica,Arial,sans-serif;line-height:150%;color:#1A1A1A;\""><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\""><strong>Customer Spotlight: Marcus, 34, Atlanta</strong></p><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\"">Marcus came to us after two years of trying everything — concealers, fibers, even a consultation for a transplant that did not feel right. \""I just wanted to look in the mirror and see myself again,\"" he told us. He started with our Apex Hybrid system and has not looked back. Six months in, he says the biggest change is not how he looks — it is how he carries himself. \""I stopped avoiding photos. I stopped thinking about it. That is the real difference.\""</p><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\"">Marcus is one of hundreds of men in our community who made the decision to stop waiting and start living. His full story is on our blog.</p><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\""><strong>Product Tip of the Month:</strong> If your bond is not lasting as long as you would like, check your scalp prep. Nine times out of ten, a shorter bond life comes from residue left behind during removal. Switch to a dedicated adhesive remover and give your scalp a full 60-second cleanse before reapplying. You will notice the difference immediately.</p><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\""><strong>Community Update:</strong> Our private Facebook group crossed 2,000 members this month. If you are not in there yet, it is the best place to ask questions, share your results, and connect with guys who get it. We also shipped our 10,000th order last week — a milestone that would not have happened without you.</p><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\"">Thank you for being part of this. More good things are coming.</p></div>"",""lineNumber"":94,""parent_widget_container"":null,""schema_version"":2,""startPosition"":-442}",74c8a3b7e3ec18d03764c4a60977c540cccb99fff923a9f9992fa93c9e2845f8,False,True,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
