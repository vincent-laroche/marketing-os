usage_214987971625_module_1_0_0_1,214987971625,CP W21 — Vip Early Access,AUTOMATED_DRAFT,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/ecommerce/ecommerce_abandoned_cart_4.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,,module-1-0-0,,,,section-1,1,0,0,,"{""css_class"":""dnd-module"",""hs_enable_module_padding"":true,""hs_wrapper_css"":{""padding-bottom"":""28px"",""padding-left"":""40px"",""padding-right"":""40px"",""padding-top"":""16px""},""html"":""<div style=\""font-family:Helvetica Neue,Helvetica,Arial,sans-serif;line-height:150%;color:#FFFFFF;\""><h1 style=\""margin:0;font-family:Arial Black,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:52px;line-height:108%;font-weight:700;letter-spacing:-0.3px;text-align:center;color:#FFFFFF;\"">VIP EARLY ACCESS — JUST FOR YOU.</h1><p style=\""margin:16px 0 0 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;text-align:center;color:#FFFFFF;\"">A thank-you reserved for our best customers.</p></div>"",""lineNumber"":94,""parent_widget_container"":null,""schema_version"":2,""startPosition"":-442}",e1878edf37bb21c67c69b73c5c7f2dafe1f787d250172b69aa65b16857b24465,False,True,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214987971625_module_2_0_0_2,214987971625,CP W21 — Vip Early Access,AUTOMATED_DRAFT,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/ecommerce/ecommerce_abandoned_cart_4.html,builtin_hubspot_image_email,builtin_hubspot,HubSpot built-in modules,@hubspot/image_email,,module-2-0-0,,,,section-2,2,0,0,,"{""css_class"":""dnd-module"",""hs_enable_module_padding"":true,""hs_wrapper_css"":{""padding-bottom"":""20px"",""padding-left"":""20px"",""padding-right"":""20px"",""padding-top"":""20px""},""img"":{""alt"":""Hair Solutions Co. homepage banner featuring premium hair systems"",""height"":320,""loading"":""disabled"",""src"":""https://res.cloudinary.com/dtmizxj1n/image/upload/w_600,h_250,c_fill,g_auto,q_auto,f_auto/v1/Home_2.0._-_Header_Banner_1"",""width"":560},""lineNumber"":61,""link"":""https://hairsolutions.co/collections/vip-early-access"",""parent_widget_container"":null,""schema_version"":2,""startPosition"":-1015}",e8e4a8f62bc0d3d9257d06168040bdd4d2cabe618f934065be26651d67041916,False,True,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
usage_214987971625_module_3_0_0_3,214987971625,CP W21 — Vip Early Access,AUTOMATED_DRAFT,AUTOMATED_EMAIL,all_emails_recheck.json,,snapshot,draft_snapshot_if_source_was_draft_else_export_snapshot,@hubspot/email/ecommerce/ecommerce_abandoned_cart_4.html,builtin_hubspot_rich_text,builtin_hubspot,HubSpot built-in modules,@hubspot/rich_text,,module-3-0-0,,,,section-3,3,0,0,,"{""css_class"":""dnd-module"",""hs_enable_module_padding"":true,""hs_wrapper_css"":{""padding-bottom"":""20px"",""padding-left"":""40px"",""padding-right"":""40px"",""padding-top"":""16px""},""html"":""<div style=\""font-family:Helvetica Neue,Helvetica,Arial,sans-serif;line-height:150%;color:#1A1A1A;\""><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\"">You are receiving this because you are one of our most valued customers. Not everyone gets this email, and that is by design. We wanted you to be the first to know about something we have been working on.</p><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\"">Next week, we are publicly launching a new system that we believe is our best work yet — but before it goes live on the site, we are giving you early access starting right now. You will be able to order it before anyone else sees it, at a VIP price that will not be available once we go public.</p><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\"">We are not ready to share every detail in this email, but here is what we can tell you: this system addresses the two most common requests we have received over the past year — a base that combines the durability of poly with the natural look of lace, at a price point that makes it realistic to rotate multiple units. We listened, and we built exactly that.</p><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\"">As a VIP customer, you also get complimentary priority shipping on this order — no code needed, it is already applied to your account.</p><p style=\""margin:0 0 16px 0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;line-height:150%;font-weight:400;color:#1A1A1A;\"">This early access window closes in 72 hours or when the first production run sells out, whichever comes first. After that, it goes to the full list at regular pricing. We wanted to make sure you had the first opportunity because your support is what makes products like this possible.</p></div>"",""lineNumber"":94,""parent_widget_container"":null,""schema_version"":2,""startPosition"":-442}",e2895a1840dbc4c5efa34ef3cd9d166e0380cab3a2c6415acba9c57820146c21,False,True,2026-07-03,observed_in_hubspot_json,legacy_builtin_or_native_hubspot_module,
