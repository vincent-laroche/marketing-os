                "id": "html_9",
                "type": "html",
                "values": {
                  "html": "<!- Atelier Zero v7 -->\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background-color:transparent;border-collapse:collapse;margin:0;\" width=\"100%\"><tr><td align=\"center\" style=\"padding:7px 16px;\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"az-module-shell\" role=\"presentation\" style=\"max-width:568px;background-color:#F6EFD9;border:none;border-radius:16px;border-collapse:separate;\" width=\"100%\"><tr><td class=\"az-content-pad\" style=\"padding:32px 30px;\"><div style=\"font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:28px;font-weight:700;line-height:1.2;color:#151411;letter-spacing:-0.3px;\">Still in your cart</div><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-collapse:collapse;margin-top:16px;\" width=\"100%\">{% for line_item in abandoned_checkout.line_items limit:5 %}<tr><td style=\"padding:12px 0;border-bottom:1px solid #C7BFAC;\" width=\"70%\"><div style=\"font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;color:#151411;line-height:1.4;\">{{ line_item.product_title }}</div>{% if line_item.variant_title != blank %}<div style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,'Courier New',monospace;font-size:13px;color:#25221D;padding-top:4px;\">{{ line_item.variant_title }}</div>{% endif %}</td><td align=\"right\" style=\"padding:12px 0;border-bottom:1px solid #C7BFAC;font-family:'SF Mono',ui-monospace,Menlo,Consolas,'Courier New',monospace;font-size:13px;color:#151411;\">Qty {{ line_item.quantity }}</td></tr>{% endfor %}{% if abandoned_checkout.remaining_products_count > 0 %}<tr><td colspan=\"2\" style=\"padding:10px 0 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;color:#25221D;\">+ {{ abandoned_checkout.remaining_products_count }} more item{% if abandoned_checkout.remaining_products_count != 1 %}s{% endif %}</td></tr>{% endif %}</table><table align=\"left\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"margin:0;\"><tr><td style=\"padding-top:20px;\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:auto;border-collapse:separate;\"><tr><td style=\"background-color:#EA6452;border-radius:999px;border:none;\"><a class=\"az-cta\" href=\"{{ checkout.url }}\" rel=\"noopener noreferrer\" style=\"display:inline-block;padding:14px 24px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;letter-spacing:0.4px;color:#151411;text-decoration:none;background-color:#EA6452;border:none;border-radius:999px;line-height:1.2;min-height:44px;box-sizing:border-box;\" target=\"_blank\">Finish your order →</a></td></tr></table></td></tr></table></td></tr></table>",
