                  "html": "<!-- Atelier Zero v7 -->\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background-color:transparent;border-collapse:collapse;margin:0;\" width=\"100%\"><tr><td align=\"center\" style=\"padding:7px 16px;\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"az-module-shell\" role=\"presentation\" style=\"max-width:568px;background-color:#F6EFD9;border:none;border-radius:16px;border-collapse:separate;\" width=\"100%\"><tr><td class=\"az-content-pad\" style=\"padding:32px 30px;\"><div style=\"font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#151411;padding-bottom:10px;\">Your preferences</div><div class=\"hsc-rt\" style=\"font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#25221D;padding-top:0px;\">You can hear from us less often, or not at all. Either is completely fine and it will not affect your order or your support.</div><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-collapse:collapse;margin-top:16px;\" width=\"100%\"><tr><td style=\"padding:10px 0;border-bottom:1px solid #C7BFAC;\"><a href=\"https://hairsolutions.co/pages/edit-notifications\" style=\"font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;color:#151411;text-decoration:underline;\">Send me less often</a></td></tr><tr><td style=\"padding:10px 0;border-bottom:1px solid #C7BFAC;\"><a href=\"https://hairsolutions.co/pages/edit-notifications\" style=\"font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;color:#151411;text-decoration:underline;\">Update my preferences</a></td></tr><tr><td style=\"padding:10px 0;border-bottom:1px solid #C7BFAC;\"><a href=\"{{ unsubscribe_url }}\" style=\"font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;color:#151411;text-decoration:underline;\">Unsubscribe entirely</a></td></tr></table></td></tr></table></td></tr></table>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background-color:transparent;border-collapse:collapse;margin:0;\" width=\"100%\"><tr><td align=\"center\" style=\"padding:7px 16px 24px;\"><div style=\"font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;line-height:1.7;color:#25221D;text-align:center;\">Hair Solutions Co.<br>Ehitajate tee 110, Tallinn, Harjumaa 13517, Estonia<br><a href=\"https://hairsolutions.co/pages/edit-notifications\" style=\"color:#25221D;text-decoration:underline;\">Manage preferences</a> &middot; <a href=\"https://hairsolutions.co/policies/privacy-policy\" style=\"color:#25221D;text-decoration:underline;\">Privacy</a></div></td></tr></table>",
