                  "html": "<style>\n@media only screen and (max-width:480px){\n  .az-module-shell{width:100%!important;max-width:100%!important;}\n  .az-module-shell .az-mobile-pad{padding-left:24px!important;padding-right:24px!important;}\n  .az-module-shell .az-stack{display:block!important;width:100%!important;box-sizing:border-box!important;}\n  .az-module-shell li{font-size:16px!important;line-height:1.6!important;}\n  .az-module-shell td{max-width:100%!important;box-sizing:border-box!important;overflow-wrap:anywhere!important;}\n  .az-module-shell img{max-width:100%!important;height:auto!important;}\n}\n</style>\n<style>\n@media only screen and (max-width:480px){\n  .az-module-shell{width:100%!important;max-width:100%!important;}\n  .az-module-shell .az-mobile-pad{padding-left:24px!important;padding-right:24px!important;}\n  .az-module-shell .az-stack{display:block!important;width:100%!important;box-sizing:border-box!important;}\n  .az-module-shell li{font-size:16px!important;line-height:1.6!important;}\n  .az-module-shell td{max-width:100%!important;box-sizing:border-box!important;overflow-wrap:anywhere!important;}\n  .az-module-shell img{max-width:100%!important;height:auto!important;}\n}\n</style>\n<style>.hsc-rt p{margin:0 0 12px;padding:0;}.hsc-rt p:last-child{margin-bottom:0;}</style>\n<!-- Atelier Zero v7 -->\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background-color:transparent;border-collapse:collapse;margin:0;\" width=\"100%\"><tr><td align=\"center\" style=\"padding:7px 0;\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"az-module-shell\" role=\"presentation\" style=\"max-width:568px;background-color:#F6EFD9;border:none;border-radius:16px;border-collapse:separate;\" width=\"100%\"><tr><td align=\"center\" style=\"padding:34px 26px;\"><a href=\"https://hairsolutions.co/\" rel=\"noopener noreferrer\" style=\"text-decoration:none;border:none;display:inline-block;background-color:transparent;padding:0;\" target=\"_blank\"><img alt=\"Hair Solutions Co.\" height=\"256\" src=\"https://res.cloudinary.com/dtmizxj1n/image/upload/e_trim/f_png/w_640,c_limit/v1785220022/HAIR_SOLUTIONS_MEDIA_LIBRARY/01_BRAND/logos/wordmark-dark-on-transparent-bg.png\" style=\"display:block;border:0;outline:none;width:320px;max-width:100%;height:auto;margin:0 auto;\" width=\"320\"/></a></td></tr></table>",
