.DS_Store
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/

# HubSpot / CRM exports — PII-bearing, never commit
exports/

# Playwright / browser automation state (large, machine-local, may hold session cookies)
.browser-profile/
.playwright-mcp/

# Claude Code: keep project settings, ignore local worktree copies
.claude/worktrees/

# Generated Email Marketing OS artifacts
.tmp/
node_modules/
tools/email-preview/node_modules/
email-previews/review/
email-previews/site/

# Generated Social Media OS review artifacts
social-media/previews/
social-media/.generated/

# Production social media is stored in the approved asset system, not Git
social-media/assets/media/

# Local dry-run synchronization output
social-media/github-issue-plan.json

# Migrated Social Studio local/build artifacts
apps/social-studio/node_modules/
apps/social-studio/.next/
apps/social-studio/dist/
apps/social-studio/.vinext/
apps/social-studio/.wrangler/
apps/social-studio/*.tsbuildinfo

# Local tool state — machine-specific, not project source.
# NOTE: .claude/agents/ is deliberately NOT ignored. It is generated from the
# authored .codex/agents tree, but committed and reproducibility-tested, the
# same way github-campaign-os/*.json is. See tools/sync_claude_agents.py.
.claude/hooks/
.claude/settings.json.bak-*
.claude/worktrees/
.cline/
.kiro/

# Vendored or scratch workspaces — dependencies and build output, never repo content
beefree-sdk/
figma-plugin/
mailerlite-blocks/
proof-email/

# Skill package: authored under .claude/skills, distributed separately
email-marketing-os-github-project/
email_marketing_os_github_project_skill.zip
