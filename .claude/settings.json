{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__mailerlite__list_*",
      "mcp__mailerlite__get_*",
      "mcp__mailerlite__search",
      "mcp__mailerlite__validate_*",
      "mcp__mailerlite__dry_run_automation",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue:*)",
      "Read(//Users/vMac/08_brand/**)",
      "Read(//Users/vMac/07_design/**)",
      "Read(//Users/vMac/04_marketing/**)"
    ],
    "deny": [
      "mcp__mailerlite__schedule_campaign",
      "mcp__mailerlite__delete_campaign",
      "mcp__mailerlite__delete_subscriber",
      "mcp__mailerlite__delete_group",
      "mcp__mailerlite__delete_segment",
      "mcp__mailerlite__delete_automation",
      "mcp__mailerlite__delete_field",
      "mcp__mailerlite__delete_form",
      "mcp__mailerlite__delete_webhook",
      "mcp__mailerlite__import_subscribers_to_group",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "mcp__mailerlite__create_campaign",
      "mcp__mailerlite__update_campaign",
      "mcp__mailerlite__cancel_campaign",
      "mcp__mailerlite__create_automation",
      "mcp__mailerlite__build_custom_automation",
      "mcp__mailerlite__send_test_automation",
      "mcp__mailerlite__update_automation_*",
      "mcp__mailerlite__create_webhook",
      "mcp__mailerlite__update_webhook",
      "Bash(gh pr merge:*)",
      "Bash(git branch -D:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/agent_sync_guard.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "brand@brand-design-marketplace": true,
    "marketing@toolkit-marketplace": true,
    "content-marketing@claude-code-workflows": true
  }
}
